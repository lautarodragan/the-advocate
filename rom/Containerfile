# Toolchain para el PoC de Super Nintendo, aislado en un contenedor.
#
# Todo sale de los paquetes de Debian: nada clonado de internet ni compilado de
# fuentes sin revisar. El SPC700, que no tiene ensamblador empaquetado, lo cubre
# tools/spc700.py, que es código nuestro.
FROM docker.io/library/debian@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867

RUN apt-get update && apt-get install -y --no-install-recommends \
        cc65 \
        make \
        mednafen \
        python3-minimal \
        xvfb \
        x11-utils \
    && rm -rf /var/lib/apt/lists/*

# mednafen se instala en /usr/games, que no está en el PATH por defecto.
ENV PATH=/usr/games:$PATH
WORKDIR /abl
