              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "of degenerative eye disease."
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "None of the doctors knew of any"
