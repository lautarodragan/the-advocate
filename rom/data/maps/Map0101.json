            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "not let their surprise attack go unpunished."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Surl was wiped off the face of the planet."
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "They never had a chance."},
            {"code": 11330, "indent": 0, "parameters": [10001, 8, 0, 0, 1], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DALIA"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "But they deserved it! The missile that got"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "through killed 50,000 people!"
            },
            {"code": 11330, "indent": 0, "parameters": [4, 8, 0, 0, 15], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "How many innocent people do you think"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "there were in Surl Kingdom, eh? Half a"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "dozen? A few hundred?"},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DALIA"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "... ... ..."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The leaders of Surl were frightened"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "of the Agency's power, at least partially"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "because of what I made: the Advocate."
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "It was that fear that prompted them to"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "launch their missiles. I am responsible for"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "the destruction of a nation."
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DALIA"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Professor Eisen, I just..."
