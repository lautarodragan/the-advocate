            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "if you listened to my story... so I will."
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I'll need your help, though. If you could"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "get in the simulation chamber over there..."
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "DALIA"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Thank you, Professor. The Agency will be"
            },
            {
              "code": 20110,
              "indent": 0,
