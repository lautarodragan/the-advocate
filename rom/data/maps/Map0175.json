            {"code": 10120, "indent": 0, "parameters": [0, 0, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Many years ago, I and several others came"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "to this place amongst the mountains, fleeing"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "for our lives."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "There was... let us say, \"turmoil,\" within the"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "upper ranks of the Agency, and we fled with"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "their best troops in hot pursuit."
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "For weeks we hid among the caves and"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "rocky peaks of the mountains, living on"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "what we could scavenge."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The Agency troops hunted for us, and although"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "we lost one of our number, the rest of us made"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "it safely... here."},
            {"code": 11410, "indent": 0, "parameters": [15], "string": ""},
            {"code": 10810, "indent": 0, "parameters": [176, 4, 7], "string": ""}
