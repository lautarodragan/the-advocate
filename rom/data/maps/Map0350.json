            {"code": 11410, "indent": 0, "parameters": [15], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I knew that someone was bringing some"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "of our foodstocks to the bandits every"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "few weeks. The inventory didn't match up."
            },
            {"code": 11410, "indent": 0, "parameters": [15], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I had hoped it wasn't you, Radin."
            },
            {"code": 11330, "indent": 0, "parameters": [4, 8, 0, 0, 14, 23, 13], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "RADIN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Sir, I - "},
            {"code": 11410, "indent": 0, "parameters": [15], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "When you first joined us, you said that"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "your ties with the bandits were severed."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I made it clear this was a binding condition."
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Their raids have turned deadly, Radin."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "They have wounded and killed our people!"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "How can you, in clear conscience, aid them?"
            },
            {"code": 11410, "indent": 0, "parameters": [15], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [4, 8, 0, 0, 14], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [15], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "RADIN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Because... they were my friends, sir."
            },
            {"code": 11410, "indent": 0, "parameters": [12], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [4, 8, 0, 0, 14], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [8], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The bonds of friendship are very strong,"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I know. But are we not also your friends?"
            },
            {"code": 11410, "indent": 0, "parameters": [25], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I will think about whether this action"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "merits banishment from Paradise. But"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "perhaps that won't be necessary."
            },
            {"code": 11330, "indent": 0, "parameters": [3, 8, 0, 0, 15], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Goodnight, Radin."},
            {"code": 11330, "indent": 0, "parameters": [3, 8, 0, 0, 2], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 11030, "indent": 0, "parameters": [0, 0, 0, 100, 0, 0], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [1, 1, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "RADIN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "zzz... tell him this time... please... zzz..."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "... tell him about the deal..."
            },
            {"code": 11030, "indent": 0, "parameters": [40, 20, 60, 100, 5, 1], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [0, 0, 0, 0], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [4, 8, 0, 0, 13], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "RADIN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Sir..."},
            {"code": 11330, "indent": 0, "parameters": [3, 8, 0, 0, 15], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Yes? Is something else troubling you?"
            },
            {"code": 11410, "indent": 0, "parameters": [30], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "RADIN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "... No, sir."},
