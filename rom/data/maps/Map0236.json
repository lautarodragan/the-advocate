            {"code": 11330, "indent": 0, "parameters": [1, 8, 0, 0, 13], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "AGENCY CAPTAIN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Take the hovercraft back to Prima."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Our Slicer should be ready by the"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "time you get there."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "AGENCY CAPTAIN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I will return to Prima shortly with new"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "orders."},
            {"code": 11410, "indent": 0, "parameters": [2], "string": ""},
