From 400815b6938748d18d2c8d2c90fd3041a6cc6609 Mon Sep 17 00:00:00 2001
From: taro <taro@taro.codes>
Date: Tue, 17 Nov 2026 03:21:44 -0300
Subject: [PATCH] msu1: log the accesses to the MSU-1's registers

Every write to $2000-$2007 and every read of $2000, in order, with the
status $2000 gave just before and where the track was playing, and each
run of reads of $2001 as one entry with how many: for a frontend that
wants to check the order a program speaks to the MSU-1 in (pause, wait,
seek, wait, play), and which seeks nobody read from. The libretro core
exposes the log as memory id 0x8001, and the frontend zeroes its count.
It changes no emulation.
---
 bsnes/sfc/coprocessor/msu1/msu1.cpp | 27 +++++++++++++++++++++++++--
 bsnes/sfc/coprocessor/msu1/msu1.hpp | 19 +++++++++++++++++++
 bsnes/target-libretro/libretro.cpp  |  5 +++++
 3 files changed, 49 insertions(+), 2 deletions(-)

diff --git a/bsnes/sfc/coprocessor/msu1/msu1.cpp b/bsnes/sfc/coprocessor/msu1/msu1.cpp
index 2caf4e2..786d461 100644
--- a/bsnes/sfc/coprocessor/msu1/msu1.cpp
+++ b/bsnes/sfc/coprocessor/msu1/msu1.cpp
@@ -3,6 +3,7 @@
 namespace SuperFamicom {
 
 MSU1 msu1;
+MSU1AccessLog msu1AccessLog;
 
 #include "serialization.cpp"
 
@@ -109,12 +110,19 @@ auto MSU1::audioOpen() -> void {
   io.audioError = true;
 }
 
+static auto msu1Log(uint8_t kind, uint8_t reg, uint8_t value, uint8_t status, uint32_t playOffset) -> void {
+  if(msu1AccessLog.count < 256) {
+    msu1AccessLog.entries[msu1AccessLog.count] = {kind, reg, value, status, playOffset};
+  }
+  msu1AccessLog.count++;
+}
+
 auto MSU1::readIO(uint addr, uint8) -> uint8 {
   cpu.synchronizeCoprocessors();
 
   switch(0x2000 | addr & 7) {
-  case 0x2000:
-    return (
+  case 0x2000: {
+    uint8 status = (
       Revision       << 0
     | io.audioError  << 3
     | io.audioPlay   << 4
@@ -122,7 +130,18 @@ auto MSU1::readIO(uint addr, uint8) -> uint8 {
     | io.audioBusy   << 6
     | io.dataBusy    << 7
     );
+    msu1Log(1, 0, status, status, io.audioPlayOffset);
+    return status;
+  }
   case 0x2001:
+    // A run of reads is one entry, `value` saying how many, up to 255.
+    if(msu1AccessLog.count && msu1AccessLog.count <= 256
+    && msu1AccessLog.entries[msu1AccessLog.count - 1].kind == 2) {
+      auto& last = msu1AccessLog.entries[msu1AccessLog.count - 1];
+      if(last.value < 255) last.value++;
+    } else {
+      msu1Log(2, 1, 1, 0, io.audioPlayOffset);
+    }
     if(io.dataBusy) return 0x00;
     if(!dataFile) return 0x00;
     if(dataFile->end()) return 0x00;
@@ -141,6 +160,10 @@ auto MSU1::readIO(uint addr, uint8) -> uint8 {
 
 auto MSU1::writeIO(uint addr, uint8 data) -> void {
   cpu.synchronizeCoprocessors();
+  msu1Log(0, addr & 7, data,
+    Revision << 0 | io.audioError << 3 | io.audioPlay << 4
+    | io.audioRepeat << 5 | io.audioBusy << 6 | io.dataBusy << 7,
+    io.audioPlayOffset);
 
   switch(0x2000 | addr & 7) {
   case 0x2000: io.dataSeekOffset = io.dataSeekOffset & 0xffffff00 | data <<  0; break;
diff --git a/bsnes/sfc/coprocessor/msu1/msu1.hpp b/bsnes/sfc/coprocessor/msu1/msu1.hpp
index 0b3f937..efdde00 100644
--- a/bsnes/sfc/coprocessor/msu1/msu1.hpp
+++ b/bsnes/sfc/coprocessor/msu1/msu1.hpp
@@ -51,3 +51,22 @@ private:
 };
 
 extern MSU1 msu1;
+
+// Every write to $2000-$2007 and every read of $2000, in order, with the
+// status a read of $2000 would have given just before and where the track
+// was playing, and each run of reads of $2001 as one entry; the libretro
+// core exposes it and the host zeroes `count`. Past `entries`' end only
+// `count` goes on.
+struct MSU1AccessLog {
+  struct Entry {
+    uint8_t kind;        // 0 a write, 1 a read of $2000, 2 reads of $2001
+    uint8_t reg;         // 0-7, from $2000
+    uint8_t value;       // what was written, what the read gave, or how
+                         // many reads of $2001 in a row (up to 255)
+    uint8_t status;      // $2000 just before
+    uint32_t playOffset; // where the track was, in bytes of its file
+  };
+  uint32_t count;
+  Entry entries[256];
+};
+extern MSU1AccessLog msu1AccessLog;
diff --git a/bsnes/target-libretro/libretro.cpp b/bsnes/target-libretro/libretro.cpp
index 3ccb781..678f537 100644
--- a/bsnes/target-libretro/libretro.cpp
+++ b/bsnes/target-libretro/libretro.cpp
@@ -1049,6 +1049,9 @@ void *retro_get_memory_data(unsigned id)
 	// A custom id: the accurate PPU's audit, see DisplayAccessAudit.
 	if (id == 0x8000)
 		return &SuperFamicom::displayAccessAudit;
+	// Another: the MSU-1's accesses, see MSU1AccessLog.
+	if (id == 0x8001)
+		return &SuperFamicom::msu1AccessLog;
 	if (id == RETRO_MEMORY_SYSTEM_RAM)
 		return SuperFamicom::cpu.wram;
 	return nullptr;
@@ -1058,6 +1061,8 @@ size_t retro_get_memory_size(unsigned id)
 {
 	if (id == 0x8000)
 		return sizeof(SuperFamicom::displayAccessAudit);
+	if (id == 0x8001)
+		return sizeof(SuperFamicom::msu1AccessLog);
 	if (id == RETRO_MEMORY_SYSTEM_RAM)
 		return sizeof(SuperFamicom::cpu.wram);
 	return 0;
-- 
2.55.0

