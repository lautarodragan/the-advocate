# The tools' recipes: generating the bytecode, running their tests —the
# Python ones and each Rust project's— and installing the suite. A Blurred
# Line's are in its own `justfile`, which does not know this directory exists.
#
# From the root it is called with `just -f tools/justfile <recipe>`; from
# inside `tools/`, with `just <recipe>`, because `just` uses the nearest
# `justfile`. Either way the recipes run standing in `tools/`.

# Where `just install` and `just install-scripts` install. In the container
# `/usr/local` is on the PATH; from the host `CARGO_ROOT=~/.cargo`, cargo's
# default, is better.
cargo_root := env_var_or_default("CARGO_ROOT", "/usr/local")

# A worktree's tools, used by the recipes in this file: they run the
# worktree's if the agent is modifying one and installed it here, with
# `just install-local <this directory>/.local-tools <project>`. Each game
# puts its own wherever
# it wants and tells `install-local` where: this file does not know where
# any of them lives.
local_tools := justfile_directory() / ".local-tools"
export PATH := if path_exists(local_tools / "bin") == "true" { local_tools / "bin" + ":" + env_var("PATH") } else { env_var("PATH") }

# The Rust projects, in the order they are installed. `project` and `rules`
# are libraries: they have nothing to install, and they go into the
# binaries that use them —`project` into `cartridge`'s and the others', `rules` into
# `rm2k-render` and `battle`—, which are compiled with them. So a branch
# that changes `rules` reinstalls those two, not `rules`.
#
# They are one Cargo workspace —`Cargo.toml`, here—, with one `Cargo.lock`
# and one `target/`, but each is still tested and installed on its own: the
# `*-test` recipes run `cargo test` standing in the project, which tests
# only that one, and `cargo install --locked --path` takes the workspace's
# lock.
rust_projects := "gunter goombario ditto rules adeleine voodoo lz2 resample rm2k-render project bytecode cartridge patches rm2k-snes-audio battle events map-background map-sprites wally text screens images mapdata convert"

# The directories the projects live in, one per layer: each project is
# `<layer>/<name>`, and the recipes find it by its name.
rust_layers := "snes rm2k rm2k-snes"

# The tools' Python tests, the ones in `tests/`: those that need neither the
# game, nor its data, nor a built cartridge. Those that do are among A Blurred
# Line's. They are fast, so they run serially and without xdist.
#
# None reads a SoundFont any more: the music's that do are in Rust, in
# `audio-test`, and get it the same way, in `SOUNDFONT`. `pytest` takes `tests/` from `pytest.ini`, so whatever is passed to it —a
# file, `-k`— works the same as in a plain `pytest`.
test *args:
  pytest {{args}}

# Every Rust project's tests at once, the whole workspace, in the debug
# profile: the release one is `lto` and a single codegen unit, and compiling
# every test binary that way costs more than the tests save. The ones that
# need a game or a SoundFont are skipped the same way as in each project's
# recipe, unless `DITTO_CORPUS` or `SOUNDFONT` are set.
rust-test *args:
  cargo test --workspace {{args}}

# Gunter: the BRR codec and the SoundFont reader, and **what builds the ROM's
# samples**. Its tests are samples generated inside the test —silence, ramp,
# square, impulse, clipping— plus the error messages, so they need neither
# the game nor a soundfont. That the real samples come out right is enforced
# by any ROM, because they travel inside the `.sfc`.
gunter-test:
  cd snes/gunter && cargo test

# .ldb/.lmu/.lmt ⇄ JSON in Rust, and as a library the one place in Rust that
# reads a dump: the converter and every stage read the game through it. See
# DITTO.md, at the root, which is what ties Ditto to the port; inside `rm2k/ditto/` there is not a single reference
# to us, on purpose.
#
# The game it is measured against **is passed by whoever runs it**, in
# DITTO_CORPUS: the tools know no game, so they do not fall into anyone's.
# Without the variable, the tests that need it are skipped with a message and
# the rest —the schema defaults, the synthetic corpus— run anyway.
#
# The short suite runs over a sample of maps; `ditto-round-trip` is every
# map, the LDB and the tree, and measures the only thing that makes the tool
# useful: that the binary comes back **byte for byte**. It is separate
# because it is the one you want to see with the number, not the one that
# runs quietly; and without a corpus it measures nothing, so instead of
# skipping it refuses.
ditto-test:
  cd rm2k/ditto && cargo test

ditto-round-trip:
  #!/usr/bin/env sh
  set -eu
  if [ -z "${DITTO_CORPUS:-}" ]; then
    echo "ditto-round-trip needs a game: DITTO_CORPUS=<folder with RPG_RT.ldb, RPG_RT.lmt and the Map*.lmu>." >&2
    exit 1
  fi
  cd rm2k/ditto
  cargo test --release -- --include-ignored --nocapture

# rm2k-rules: what the data of an RPG Maker 2000 game means —passability,
# which layer covers which, the page a new game starts on and what it
# draws, the experience curve, what a map inherits from the tree—, over
# Ditto's types. The same rules are still in Python, in the converter, and
# the two are held together by `rm2k/rules/tests/python.json`: what the
# Python answered for some inputs, which this checks the Rust against and
# `tests/test_rm2k_rules.py` the Python. They need no game.
rules-test:
  cd rm2k/rules && cargo test

# Adeleine: which colors a picture loses and how the ones left are grouped
# into palettes, in Rust. It is what decides the colors Voodoo later
# converts; see AGENTS.md. The converter's stages use it as a library.
#
# Its tests generate their colors and tiles inside the test, and compare
# against the hashes of what the Python it replaced gave for the same input
# on 2026-09-29: they do not need the game.
adeleine-test:
  cd snes/adeleine && cargo test

# Voodoo: from an indexed PNG to tiles, tilemap and CGRAM, in Rust. It is what
# converts the map layers, from the images Adeleine leaves. It does not
# decide colors; see AGENTS.md.
#
# Its tests are images generated inside the test, plus the error messages,
# so they do not need the game.
voodoo-test:
  cd snes/voodoo && cargo test

# Goombario: static checks for 65816 code built with ca65 and ld65 —a
# branch on what a pull left, `jsl` against `rts`, the stack, the widths—.
# Its tests assemble toy programs, so they need `ca65` and `ld65` on the
# PATH, and skip without them; they do not need the game.
goombario-test:
  cd snes/goombario && cargo test

# LZ2: Nintendo's LC_LZ2, which the converter uses to compress the tiles and
# grids the ROM decompresses when loading a map, as a library of the emission
# and the converter.
# Its tests do not need the game; the ones that run every block of the
# cartridge through the reference are the port's.
lz2-test:
  cd snes/lz2 && cargo test --release

# resample: Pillow's LANCZOS resize, to the bit, which the pictures of the
# converter are scaled with —see `rm2k-snes-images`—. A library.
#
# Its tests resize noise made inside the test and compare against the
# hashes of what Pillow wrote for it: they do not need the game.
resample-test:
  cd snes/resample && cargo test

# rm2k-render: what RPG Maker 2000 draws, as PNGs —a map's tile layers and
# the other drawings of its ChipSet animation, the CharSet sheets its events
# are drawn with, a battle's animations, backdrops and enemies, and the faces,
# windows and pictures of the screens—, as a library of the stages that draw.
# The directory is named after the binary because `render/` was, until
# 2026-10-02, the converter's Python that asked it for pictures.
#
# Its tests draw ChipSets, CharSets and a map generated inside the test, and
# compare against the hashes of what the Python that drew them gave for the
# same input —until 2026-09-29 the layers, until 2026-09-30 the CharSets—:
# they need neither the game nor the RTP.
render-test:
  cd rm2k/rm2k-render && cargo test --release

# The project library: finding `rm2k-snes.toml`, reading its settings with
# errors that name the key, the machine's flags and the disk cache's key.
# Its tests build their projects inside the test, so they need no game.
project-test:
  cd rm2k-snes/project && cargo test

# `rm2k-snes-assemble`, `rm2k-snes-space` and `rm2k-snes-cartridges`: the
# bank packing, the memory map, the checksum and the symbols are tested on
# files made inside the test. That the ROMs come out right is enforced by
# the game's suite, which runs them; building a real cartridge needs a game.
cartridge-test:
  cd rm2k-snes/cartridge && cargo test

# `rm2k-snes-patches`: what the converter decided to lose —the colors of a
# map's layers and of each battler, the size of each battle animation—,
# written as TOML next to each ROM, copied to the project and checked
# against every cartridge. Its tests write and check a small game made of
# requests, in `tests/game/`, and compare against what the Python that did
# this until 2026-09-30 answered for it: they need no game.
patches-test:
  cd rm2k-snes/patches && cargo test

# rm2k-snes-audio: the music, from each song's MIDI and the SoundFont to
# `musicdata.inc` —`rm2k-snes-convert` calls it last—. It
# uses Gunter as a library, for the SoundFont and the BRR.
#
# Its tests are notes, streams and banks built inside the test, plus the
# hashes of what the Python that compiled the music until 2026-09-29 gave for
# the same input. Two read a real SoundFont, and **whoever runs them passes
# it**, in `SOUNDFONT`, the way Ditto gets its corpus: this file does not
# know where one is. Without the variable, those two are skipped with a
# message.
audio-test:
  cd rm2k-snes/rm2k-snes-audio && cargo test --release

# rm2k-snes-battle: the battle's tables —experience and level per actor,
# each map's random encounters— from the dump and a request, as pieces of
# `mapdata.inc`; `rm2k-snes-convert` calls it.
#
# Its tests build a small game inside the test, and compare against the
# hashes of what the Python that wrote these tables until 2026-09-29 gave for
# the same input: they need no game.
battle-test:
  cd rm2k-snes/battle && cargo test

# rm2k-snes-bytecode: the two bytecodes, declared once. A broken declaration
# —two opcodes on one number, a gap in the event dispatch, a name in both—
# does not compile, so its tests are those messages, the shape of the
# equates `rm2k-snes-assemble` writes, and that the runtime uses only
# declared opcodes and writes none by hand. They need no game.
bytecode-test:
  cd rm2k-snes/bytecode && cargo test

# rm2k-snes-events: the event compiler —RM2k's pages to the bytecode the ROM
# runs—, which the converter calls twice; see `compiler.rs` in
# `rm2k-snes-convert`.
#
# Its tests compile a small game kept in `tests/game/`, and compare against
# the hashes of what the Python compiler it replaced answered for the same
# requests on 2026-09-29: they need no game.
events-test:
  cd rm2k-snes/events && cargo test

# wally: a game's maps as the cartridge carries them —each map's
# layers, its baked events, its characters as objects and its blocks—, which
# the converter calls once per map; see `maps.rs` in `rm2k-snes-convert`. The work is
# two libraries': `map-background`, the layers and the blocks, and
# `map-sprites`, the objects.
#
# Their tests build a small game, its ChipSets and CharSets inside the test:
# they need no game.
wally-test:
  cd rm2k-snes/map-background && cargo test
  cd rm2k-snes/map-sprites && cargo test
  cd rm2k-snes/wally && cargo test

# rm2k-snes-screens: a game's screens as the cartridge carries them —the
# message window and its font, the title's menu, the save slots and the
# pause menu, the text screens with their windows, End Game— and the
# message boxes reflowed for the console's window; see `screens.rs` in
# `rm2k-snes-convert`. The letters, a line of them and the reflow are
# `text`, a library.
#
# Their tests build a small game and its System inside the test, and compare
# against the hashes of what the Python that drew these screens until
# 2026-09-30 gave for the same input: they need no game.
screens-test:
  cd rm2k-snes/text && cargo test
  cd rm2k-snes/screens && cargo test

# rm2k-snes-images: a game's pictures brought to the console —the title and
# the Game Over, the picture of a `ShowPicture`, the battle backdrops and
# battlers, the battle animations—: scaled, toned, down to their palettes;
# see `images.rs` in `rm2k-snes-convert`.
#
# Its tests build their pictures inside the test, and compare against the
# hashes of what the Python that did this until 2026-09-30 gave for the
# same input: they need no game.
images-test:
  cd rm2k-snes/images && cargo test

# rm2k-snes-mapdata: the cartridge's data `.inc` —what every domain of the
# conversion answered, written for ca65—, the LZ2 streams of what the
# console decompresses, and the VRAM layouts, which it publishes for the
# maps and the screens; see `emit.rs` in `rm2k-snes-convert`.
#
# Its tests build what they emit inside the test, and compare against the
# hashes of what the Python that wrote it until 2026-10-01 gave for the same
# input: they need no game.
mapdata-test:
  cd rm2k-snes/mapdata && cargo test

# The converter, `rm2k-snes-convert`: the orchestrator that asks each stage
# above, in order, what the cartridge needs, and hands each what the others
# answered. What it decides itself —who can lead the party, which items,
# where the timer runs, which pictures and backdrops go in— is tested with
# small games made inside the test; that every stage gets the request it
# always got is what the cartridges of the game, built byte by byte the same,
# say.
convert-test:
  cd rm2k-snes/convert && cargo test

# --- Installation ----------------------------------------------------------
# The Rust projects, in `snes/`, `rm2k/` and `rm2k-snes/`, are separate
# projects, and the port consumes them **from the PATH**, the way it
# consumes a libretro core: no script or test of the game calls `cargo`.
# They are installed once and stay.
#
# And the Python scripts that get executed, into the same `bin/`, so the
# game's `justfile` calls them by name like the Rust ones. They go **as
# symlinks and not as copies**: a copy would go stale when the `.py` is
# edited, and the suite would run a different version from the tree's. They
# point to the checkout this was run from: if that one is deleted, it has to
# be run again from another.
#
# With Rust project names —`just install lz2`— it installs only those, plus
# the Python symlinks, which cost nothing: that is what whoever merges a
# branch runs, with the Rust the branch touched. Without names, all of them;
# and the symlinks alone, without compiling anything, are `install-scripts`.
#
# The names follow the repo each program will live in once the tools split
# from ABL: `rm2k-snes-` and in English for the suite's, which will be an
# English repo; `abl-` and in Spanish for the one that stays with the game.
# The prefix is because `bin/` is shared: a bare `space` or `patches` does
# not say what it is and can clash with anything.
#
# `(cargo_root)` goes in parentheses because, stuck to the parenthesis that
# follows, `just` would read it as a call to a function `cargo_root`.
install *projects: (_install (cargo_root) (if projects == "" { rust_projects } else { projects }))

# **Only the Python scripts**, into the same `bin/` as `install`: their
# symlinks, without compiling or reinstalling any Rust. It is what is run
# after a branch that renames or adds a script, because a symlink points to
# a file path, and a renamed `.py` leaves it pointing nowhere. The Rust
# binaries are left as they are.
#
# Only from the main checkout: the global symlinks point to the checkout
# they were made from, and a worktree is deleted when its branch is merged.
# A worktree has its own, with `install-local`.
install-scripts: _main_checkout_only (_install (cargo_root))

# **A worktree's tools**, for the sub-agent that modifies them. A symlink in
# the global install points to a single checkout —the main one—, so a
# worktree that changes a tools script or a Rust project would not run its
# change. This builds `<dest>/bin/` with the worktree's Python scripts,
# always, and with the Rust projects it is given, **only those**: compiling
# Rust costs, and only makes sense if the agent is going to modify that
# project. Without names it compiles nothing. From taro, 2026-09-29.
#
# **The destination is set by the consumer**, and it is mandatory: this file
# does not know where the game lives, and the game does not know where this
# one lives. The game's `justfile` looks for its `bin/` in a directory of its
# own and, if it is not there, refuses, giving this command with the
# destination already filled in. A relative destination is relative to where
# `just` was run, not to `tools/`.
#
# It only applies to what runs through `just`, which is what puts the `bin/`
# first on the PATH: a plain command uses the global one. It refuses in the
# main checkout, where it would shadow the global install with the same
# thing.
install-local dest *projects: _not_in_main_checkout (_install (join(invocation_directory(), dest)) projects)

_not_in_main_checkout:
  #!/usr/bin/env sh
  [ "$(git rev-parse --path-format=absolute --git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ] && exit 0
  echo "this is the main checkout: here the tools are the global ones, from 'just -f tools/justfile install'." >&2
  exit 1

_main_checkout_only:
  #!/usr/bin/env sh
  [ "$(git rev-parse --path-format=absolute --git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] && exit 0
  echo "this is a worktree: its scripts go in its own bin/, with 'just -f tools/justfile install-local <dest>'." >&2
  exit 1

# Installs into `root`: `cargo install` of the named Rust projects, and the
# symlinks of the Python ones. A name that is not a project stops
# before compiling anything.
_install root *projects:
  #!/usr/bin/env sh
  set -eu
  for p in {{projects}}; do
    case " {{rust_projects}} " in
      *" $p "*) ;;
      *) echo "'$p' is not a Rust project: they are {{rust_projects}}." >&2; exit 1 ;;
    esac
  done
  mkdir -p "{{root}}/bin"
  # The suite's symlinks go first, and are made again below: a name that was
  # a script and is now a Rust binary —`rm2k-snes-assemble`— would otherwise
  # stay a symlink, and `cargo install` refuses to write over what it did
  # not install. `abl-*` too, though none is installed any more: until
  # 2026-10-02 `abl-entregar` was, and it went to the game's repo with the
  # game; this is what clears the stale symlink.
  find "{{root}}/bin" -maxdepth 1 -type l \( -name 'rm2k-snes-*' -o -name 'abl-*' \) -delete
  for p in {{projects}}; do
    dir=""
    for layer in {{rust_layers}}; do
      if [ -f "$layer/$p/Cargo.toml" ]; then dir="$layer/$p"; fi
    done
    # A library has nothing to install: it goes into the binaries that use it.
    if [ ! -f "$dir/src/main.rs" ] && [ ! -d "$dir/src/bin" ] && ! grep -q '^\[\[bin\]\]' "$dir/Cargo.toml"; then
      echo "$p is a library: it is compiled into the binaries that use it"
      continue
    fi
    cargo install --locked --path "$dir" --root "{{root}}"
  done
  ln -sfn "{{justfile_directory()}}/common/python_path.py" "{{root}}/bin/rm2k-snes-python-path"
  echo "in {{root}}/bin: the Python scripts, and from Rust: {{ if projects == "" { "none" } else { projects } }}"

# Which executable this checkout resolves for each tool: the one in
# `.local-tools/bin/` if it is there, otherwise the global one.
which:
  #!/usr/bin/env sh
  for x in gunter goombario ditto adeleine voodoo lz2 rm2k-render rm2k-snes-cartridges rm2k-snes-assemble rm2k-snes-space rm2k-snes-convert rm2k-snes-patches rm2k-snes-msu rm2k-snes-volume-ceilings rm2k-snes-battle rm2k-snes-events wally rm2k-snes-screens rm2k-snes-images rm2k-snes-python-path; do
    printf '%-26s %s\n' "$x" "$(command -v "$x" || echo missing)"
  done
