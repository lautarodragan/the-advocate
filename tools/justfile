# The tools' recipes: generating the bytecode, running their tests —the
# Python ones and each Rust project's— and installing the suite. A Blurred
# Line's are in its own `justfile`, which does not know this directory exists.
#
# From the root it is called with `just -f tools/justfile <recipe>`; from
# inside `tools/`, with `just <recipe>`, because `just` uses the nearest
# `justfile`. Either way the recipes run standing in `tools/`.

# Where `just herramientas` installs. In the container `/usr/local` is on the
# PATH; from the host `CARGO_ROOT=~/.cargo`, cargo's default, is better.
cargo_root := env_var_or_default("CARGO_ROOT", "/usr/local")

# A worktree's tools, used by the recipes in this file: `protocolo` and
# `pruebas` run the worktree's `protocol` if the agent is modifying it and
# installed it here, with `just herramientas-locales
# <this directory>/.herramientas-locales protocol`. Each game puts its own
# wherever it wants and tells `herramientas-locales` where: this file does
# not know where any of them lives.
locales := justfile_directory() / ".herramientas-locales"
export PATH := if path_exists(locales / "bin") == "true" { locales / "bin" + ":" + env_var("PATH") } else { env_var("PATH") }

# The Rust projects, in the order they are installed.
proyectos_de_rust := "protocol gunter ditto voodoo lz2"

# The event opcodes: their number and their layout. The declaration lives in
# `protocol/events.toml` and belongs neither to the compiler nor to the
# interpreter; from it the two Python modules and the two `.inc` files of
# `tools/runtime/` are generated, all committed. There are two declarations:
# the event bytecode and the music stream the SPC700 reads.
#
# The event one takes `--jump-table`: that produces `correr_codigo`'s dispatch
# table, so a new opcode touches the interpreter only in its `.proc op_x`.
# The music one cannot —it ends at 0xFF— and does not need it.
#
# `--check` is what the suite runs: it fails if any of them is stale.
protocolo *args:
  protocol protocol/events.toml \
      --python port/event_opcodes.py --asm runtime/event_opcodes.inc \
      --jump-table {{args}}
  protocol protocol/music.toml \
      --python audio/music_opcodes.py --asm runtime/music_opcodes.inc {{args}}

# The tools' Python tests, the ones in `pruebas/`: those that need neither the
# game, nor its data, nor a built cartridge. Those that do are among A Blurred
# Line's. They are fast, so they run serially and without xdist.
#
# Two read a real SoundFont, and **whoever runs them passes it**, in
# `SOUNDFONT`, the way Ditto gets its corpus: this file does not know where
# one is. Without the variable, those two are skipped with a message.
# `pytest` takes `pruebas/` from `pytest.ini`, so whatever is passed to it —a
# file, `-k`— works the same as in a plain `pytest`.
pruebas *args:
  pytest {{args}}

# The generator's tests: the errors it must give for a broken declaration,
# and the exact shape of the text it emits. They need neither the game nor
# the ROM.
protocolo-pruebas:
  cd protocol && cargo test

# Gunter: the BRR codec and the SoundFont reader, and **what builds the ROM's
# samples**. Its tests are samples generated inside the test —silence, ramp,
# square, impulse, clipping— plus the error messages, so they need neither
# the game nor a soundfont. That the real samples come out right is enforced
# by any ROM, because they travel inside the `.sfc`.
gunter-pruebas:
  cd gunter && cargo test

# .ldb/.lmu/.lmt ⇄ JSON in Rust. It does not replace `rpgmaker/lcf.py` or the
# converter yet: it lives alongside them. See DITTO.md, at the root, which is
# what ties Ditto to the port; inside `ditto/` there is not a single reference
# to us, on purpose.
#
# The game it is measured against **is passed by whoever runs it**, in
# DITTO_CORPUS: the tools know no game, so they do not fall into anyone's.
# Without the variable, the tests that need it are skipped with a message and
# the rest —the schema defaults, the synthetic corpus— run anyway.
#
# The short suite runs over a sample of maps; `ditto-vuelta-entera` is every
# map, the LDB and the tree, and measures the only thing that makes the tool
# useful: that the binary comes back **byte for byte**. It is separate
# because it is the one you want to see with the number, not the one that
# runs quietly; and without a corpus it measures nothing, so instead of
# skipping it refuses.
ditto-pruebas:
  cd ditto && cargo test

ditto-vuelta-entera:
  #!/usr/bin/env sh
  set -eu
  if [ -z "${DITTO_CORPUS:-}" ]; then
    echo "ditto-vuelta-entera needs a game: DITTO_CORPUS=<folder with RPG_RT.ldb, RPG_RT.lmt and the Map*.lmu>." >&2
    exit 1
  fi
  cd ditto
  cargo test --release -- --include-ignored --nocapture

# Voodoo: from an indexed PNG to tiles, tilemap and CGRAM, in Rust. It is what
# converts the map layers, from the images the allocator leaves. It does not
# decide colors; see AGENTS.md.
#
# Its tests are images generated inside the test, plus the error messages,
# so they do not need the game.
voodoo-pruebas:
  cd voodoo && cargo test

# LZ2: Nintendo's LC_LZ2, which the converter uses to compress the tiles and
# grids the ROM decompresses when loading a map —see `port/comprimir.py`—.
# Its tests do not need the game; the ones that run every block of the
# cartridge through the reference are the port's.
lz2-pruebas:
  cd lz2 && cargo test --release

# --- Installation ----------------------------------------------------------
# `protocol/`, `gunter/`, `ditto/`, `voodoo/` and `lz2/` are separate
# projects, and the port consumes them **from the PATH**, the way it consumes
# a libretro core: no script or test of the game calls `cargo`. They are
# installed once and stay.
#
# And the Python scripts that get executed, into the same `bin/`, so the
# game's `justfile` calls them by name like the Rust ones. They go **as
# symlinks and not as copies**: a copy would go stale when the `.py` is
# edited, and the suite would run a different version from the tree's. They
# point to the checkout this was run from: if that one is deleted, it has to
# be run again from another.
#
# With Rust project names —`just herramientas lz2`— it installs only those,
# plus the Python symlinks, which cost nothing: that is what whoever merges a
# branch runs, with the Rust the branch touched. Without names, all of them.
#
# The names follow the repo each program will live in once the tools split
# from ABL: `rm2k-snes-` and in English for the suite's, which will be an
# English repo; `abl-` and in Spanish for the one that stays with the game.
# The prefix is because `bin/` is shared: a bare `espacio` or `parches` does
# not say what it is and can clash with anything.
#
# `(cargo_root)` goes in parentheses because, stuck to the parenthesis that
# follows, `just` would read it as a call to a function `cargo_root`.
herramientas *proyectos: (_instalar (cargo_root) (if proyectos == "" { proyectos_de_rust } else { proyectos }))

# **A worktree's tools**, for the sub-agent that modifies them. A symlink in
# the global install points to a single checkout —the main one—, so a
# worktree that changes a tools script or a Rust project would not run its
# change. This builds `<destino>/bin/` with the worktree's eight scripts,
# always, and with the Rust projects it is given, **only those**: compiling
# Rust costs, and only makes sense if the agent is going to modify that
# project. Without names it compiles nothing. From taro, 2026-09-29.
#
# **The destination is set by the consumer**, and it is mandatory: this file
# does not know where the game lives, and the game does not know where this
# one lives. The game's `justfile` looks for its `bin/` in a directory of its
# own and, if it is not there, refuses, giving this command with the
# destination already filled in. A relative destination is relative to where
# `just` was run, not to `tools/`.
#
# It only applies to what runs through `just`, which is what puts the `bin/`
# first on the PATH: a plain command uses the global one. It refuses in the
# main checkout, where it would shadow the global install with the same
# thing.
herramientas-locales destino *proyectos: _no_en_el_principal (_instalar (join(invocation_directory(), destino)) proyectos)

_no_en_el_principal:
  #!/usr/bin/env sh
  [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ] && exit 0
  echo "this is the main checkout: here the tools are the global ones, from 'just -f tools/justfile herramientas'." >&2
  exit 1

# Installs into `raiz`: `cargo install` of the named Rust projects, and the
# symlinks of the eight Python ones. A name that is not a project stops
# before compiling anything.
_instalar raiz *proyectos:
  #!/usr/bin/env sh
  set -eu
  for p in {{proyectos}}; do
    case " {{proyectos_de_rust}} " in
      *" $p "*) ;;
      *) echo "'$p' is not a Rust project: they are {{proyectos_de_rust}}." >&2; exit 1 ;;
    esac
  done
  for p in {{proyectos}}; do
    cargo install --locked --path "$p" --root "{{raiz}}"
  done
  mkdir -p "{{raiz}}/bin"
  ln -sfn "{{justfile_directory()}}/ensamblado/cartuchos.py" "{{raiz}}/bin/rm2k-snes-cartridges"
  ln -sfn "{{justfile_directory()}}/ensamblado/ensamblar.py" "{{raiz}}/bin/rm2k-snes-assemble"
  ln -sfn "{{justfile_directory()}}/ensamblado/espacio.py" "{{raiz}}/bin/rm2k-snes-space"
  ln -sfn "{{justfile_directory()}}/port/snes_convert.py" "{{raiz}}/bin/rm2k-snes-convert"
  ln -sfn "{{justfile_directory()}}/port/parches.py" "{{raiz}}/bin/rm2k-snes-patches"
  ln -sfn "{{justfile_directory()}}/audio/msu.py" "{{raiz}}/bin/rm2k-snes-msu"
  ln -sfn "{{justfile_directory()}}/audio/ceilings.py" "{{raiz}}/bin/rm2k-snes-volume-ceilings"
  ln -sfn "{{justfile_directory()}}/ensamblado/entregar.py" "{{raiz}}/bin/abl-entregar"
  echo "in {{raiz}}/bin: the eight Python ones, and from Rust: {{ if proyectos == "" { "none" } else { proyectos } }}"

# Which executable this checkout resolves for each tool: the one in
# `.herramientas-locales/bin/` if it is there, otherwise the global one.
cuales:
  #!/usr/bin/env sh
  for x in {{proyectos_de_rust}} rm2k-snes-cartridges rm2k-snes-assemble rm2k-snes-space rm2k-snes-convert rm2k-snes-patches rm2k-snes-msu rm2k-snes-volume-ceilings abl-entregar; do
    printf '%-26s %s\n' "$x" "$(command -v "$x" || echo missing)"
  done
