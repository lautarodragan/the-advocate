            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "AULEEN"},
            {"code": "ShowMessage_2", "string": "I'm still not very happy about doing this"},
            {"code": "ShowMessage_2", "string": "here - I always hear strange noises..."},
            {"code": "ShowMessage_2", "string": "The whole place is creepy."},
            {"code": "ShowMessage", "string": "LERLE"},
            {"code": "ShowMessage_2", "string": "I haven't seen anything strange here since"},
            {"code": "ShowMessage_2", "string": "Talan and I got the script - maybe whatever"},
