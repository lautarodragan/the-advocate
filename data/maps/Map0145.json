            {"code": "ShowMessage_2", "string": "everyone concentrate, and just do it like"},
            {"code": "ShowMessage", "string": "SEWELL"},
            {"code": "ShowMessage_2", "string": "we've been practicing. And no whispering"},
            {"code": "ShowMessage_2", "string": "backstage - the acoustics here are so good"},
            {"code": "ShowMessage_2", "string": "that the audience will hear every word!"},
            {"code": "TintScreen", "parameters": [0, 0, 0, 100, 5, 1]},
