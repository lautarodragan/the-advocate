          "event_commands": [
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "What do you want?"},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I just... wanted to apologize... for whatever"},
