            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Hmmmm... what would Max Powertrain"},
            {"code": "ShowMessage_2", "string": "from Flashbang IV say?"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "... ... ..."},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "If you were the last woman on the planet,"},
            {"code": "ShowMessage_2", "string": "and the Griznarcs were descending upon"},
            {"code": "ShowMessage_2", "string": "us, and we had ten minutes left to live..."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "... I'd go with the Griznarcs!"},
            {"code": "Wait", "parameters": [10]},
            {"code": "MoveEvent", "parameters": [10005, 8, 0, 0, 21]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "I beg your pardon?"},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Uh... I mean..."},
            {"code": "MessageOptions", "parameters": [1, 2, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I didn't seriously just say that, did I?"},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "EMILY"},
            {
              "code": "ShowMessage_2",
              "string": "Let me guess... another line from one of those"
            },
            {"code": "ShowMessage_2", "string": "vidcasts?"},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Uh... yeah."},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "Get out of here, Talan."},
