            {"code": "Wait", "parameters": [15]},
            {"code": "ShowMessage", "string": "CRYING GIRL"},
            {"code": "ShowMessage_2", "string": "What - what do you want?"},
            {"code": "Wait", "parameters": [20]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "She's... beautiful..."},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "CRYING GIRL"},
            {"code": "ShowMessage_2", "string": "Get away from me, or I'll scream!"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Listen, it's nothing like that - "},
            {"code": "ShowMessage_2", "string": "I'm a friend... I just -"},
            {"code": "ShowMessage", "string": "CRYING GIRL"},
            {
              "code": "ShowMessage_2",
              "string": "Leave me alone! This is none of your business!"
            },
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "What's wrong? Maybe I can help..."},
            {"code": "ShowMessage", "string": "CRYING GIRL"},
            {"code": "ShowMessage_2", "string": "No one can! No one understands anything!"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Maybe I -"},
            {"code": "ShowMessage", "string": "CRYING GIRL"},
            {"code": "ShowMessage_2", "string": "What would you know about anything?"},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "TALAN"},
            {
              "code": "ShowMessage_2",
              "string": "Listen... all I know is that I was sleeping, and"
            },
            {"code": "ShowMessage_2", "string": "heard you crying outside my door. I followed"},
            {"code": "ShowMessage_2", "string": "you up here."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I'm not a very smart person, but I'm smart"},
            {"code": "ShowMessage_2", "string": "enough to know what happens when"},
            {"code": "ShowMessage_2", "string": "someone crying like you climbs up  a rocky"},
            {"code": "ShowMessage", "string": "TALAN"},
            {
              "code": "ShowMessage_2",
              "string": "spire in the dead of night during a rainstorm."
            },
            {"code": "Wait", "parameters": [5]},
            {"code": "MoveEvent", "parameters": [5, 8, 0, 0, 2, 3]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "CRYING GIRL"},
            {"code": "ShowMessage_2", "string": "Oh? And what happens, Mr. \"I'm Not A"},
            {"code": "ShowMessage_2", "string": "Smart Person?\""},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "TALAN"},
            {
              "code": "ShowMessage_2",
              "string": "People get hurt. Usually, the would-be-rescuer"
            },
            {
              "code": "ShowMessage_2",
              "string": "who is willing to jump off a cliff in the vain"
            },
            {"code": "ShowMessage_2", "string": "hope of saving a pretty face."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "<shrug>"},
            {"code": "ShowMessage_2", "string": "And you don't know for a fact that I'm not"},
            {"code": "ShowMessage_2", "string": "willing to do that, so why don't you save us"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "both a lot of embarrassment and just come"},
            {"code": "ShowMessage_2", "string": "back down to the village?"},
            {"code": "MoveEvent", "parameters": [5, 8, 0, 0, 2, 13, 23, 23, 23, 23, 15]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "GIRL"},
            {"code": "ShowMessage_2", "string": "That's a cute speech. Why do you think it's"},
            {"code": "ShowMessage_2", "string": "going to work?"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Well... you've stopped crying. That's a good"},
            {"code": "ShowMessage_2", "string": "sign."},
            {"code": "ShowMessage", "string": "GIRL"},
            {"code": "ShowMessage_2", "string": "... ... ..."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Plus, that speech worked on the vidcast"},
            {"code": "ShowMessage_2", "string": "program \"Flashbang IV: Death Cult.\""},
            {"code": "ShowMessage_2", "string": "<sheepish grin>"},
            {"code": "Wait", "parameters": [20]},
            {"code": "ShowMessage", "string": "GIRL"},
            {"code": "ShowMessage_2", "string": "My name's Emily..."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Emily. That's a pretty name. My name's"},
            {"code": "ShowMessage_2", "string": "Talan."},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "That's not."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Very funny."},
            {"code": "MoveEvent", "parameters": [5, 8, 0, 0, 3, 3]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "TALAN"},
            {
              "code": "ShowMessage_2",
              "string": "All right, Emily... let's go back down where it's"
            },
            {"code": "ShowMessage_2", "string": "dry. I'm soaked."},
            {"code": "Wait", "parameters": [20]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "Talan, thank you..."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "No problem, Emily. I'm glad to help!"},
            {"code": "PlayBGM", "parameters": [0, 100, 100, 50], "string": "sladies"},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "... but this isn't a vidcast."},
