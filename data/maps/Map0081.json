            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "Oooooh... my head..."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 0, 3, 3, 3, 3, 3, 3]},
            {"code": "Wait", "parameters": [25]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Doctor, are you feeling better? I've"},
            {"code": "ShowMessage_2", "string": "brought you back to your house. You've"},
            {"code": "ShowMessage_2", "string": "been unconscious."},
            {"code": "Wait", "parameters": [5]},
            {"code": "MoveEvent", "parameters": [2, 8, 0, 0, 13]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "It's coming back to me, slowly. I was"},
            {"code": "ShowMessage_2", "string": "climbing Sorbe Mountain looking"},
            {"code": "ShowMessage_2", "string": "for ingredients..."},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "I stumbled across a patch of bloodroot!"},
            {"code": "ShowMessage_2", "string": "And then you must have found me under"},
            {"code": "ShowMessage_2", "string": "its effects!"},
            {"code": "ConditionalBranch", "parameters": [0, 150, 0, 0, 0, 1]},
            {"code": "ShowMessage", "indent": 1, "string": "AG7-17"},
            {"code": "ShowMessage_2", "indent": 1, "string": "8ry3uf73r3uy6256told you12947637"},
            {"code": "ShowMessage_2", "indent": 1, "string": "&#@%gr6367ft3g7238574384"},
            {"code": "MoveEvent", "indent": 1, "parameters": [10001, 8, 0, 0, 13]},
            {"code": "Wait", "indent": 1, "parameters": [5]},
            {"code": "ShowMessage", "indent": 1, "string": "TALAN"},
            {"code": "ShowMessage_2", "indent": 1, "string": "Shut it, AG7."},
