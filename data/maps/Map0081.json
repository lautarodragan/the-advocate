            {"code": "ShowMessage", "indent": 1, "string": "ARDEN"},
            {
              "code": "ShowMessage_2",
              "indent": 1,
              "string": "Let's go find Paradise, Talan. I know we"
            },
            {"code": "ShowMessage_2", "indent": 1, "string": "can make it."},
            {"code": "ShowMessage", "indent": 1, "string": "TALAN"},
            {
              "code": "ShowMessage_2",
              "indent": 1,
              "string": "I hope you're right, Arden. I really do."
