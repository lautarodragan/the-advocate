            {"code": "END", "indent": 1},
            {"code": "ElseBranch"},
            {"code": "END", "indent": 1},
            {"code": "EndBranch"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Bloodroot?"},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "It's a plant that sends out airborne"},
            {"code": "ShowMessage_2", "string": "seeds to reproduce. These seeds"},
            {"code": "ShowMessage_2", "string": "cause an effect in humans akin to"},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "an uncontrollable rage - centuries"},
            {"code": "ShowMessage_2", "string": "ago, berserkers used to harness this"},
            {"code": "ShowMessage_2", "string": "effect in battle."},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "Bloodroot is very dangerous, but"},
            {"code": "ShowMessage_2", "string": "fortunately it is fairly uncommon."},
            {"code": "ShowMessage_2", "string": "I apologize for attacking you."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "No harm done.  It seems that these are"},
            {"code": "ShowMessage_2", "string": "dangerous times, at least for me."},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "In any event, I'd like to make it up"},
            {"code": "ShowMessage_2", "string": "to you, somehow."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 14]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Actually, there is something you might"},
