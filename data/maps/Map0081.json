          "event_commands": [
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "So, you work for the Agency?"},
            {"code": "ShowMessage", "string": "TALAN"},
            {
              "code": "ShowMessage_2",
              "string": "Uh... sort of. Actually, I work for Delcentric,"
            },
            {"code": "ShowMessage_2", "string": "but these days the Agency basically pulls"},
            {"code": "ShowMessage_2", "string": "the strings, so, yeah. Anyway."},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "I see. Well, the Agency is certainly very"},
            {"code": "ShowMessage_2", "string": "good at pulling strings. It's made them a"},
            {"code": "ShowMessage_2", "string": "fair share of enemies, I imagine."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "That's right! Too bad I had to get caught in"},
            {"code": "ShowMessage_2", "string": "the middle - I mean..."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 14]},
            {"code": "Wait", "parameters": [15]},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "Why don't you tell me all about it, Talan?"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I wouldn't want to... bore you with the"},
            {"code": "ShowMessage_2", "string": "details..."},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "Believe me - I think I should know"},
            {"code": "ShowMessage_2", "string": "why you're running from the Agency."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 24, 25, 23, 15]},
            {"code": "Wait", "parameters": [8]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I never said anything about running!"},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "You're not very good at concealing your"},
            {
              "code": "ShowMessage_2",
              "string": "motives, Talan. It's a good thing you ran into"
            },
            {"code": "ShowMessage_2", "string": "me, rather than someone more..."},
            {"code": "ShowMessage", "string": "DR. VAGO"},
            {"code": "ShowMessage_2", "string": "...accepting... of the Agency's role in world"},
            {"code": "ShowMessage_2", "string": "power these days.  Start from the top, and"},
            {"code": "ShowMessage_2", "string": "maybe I'll be able to help you."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 13]},
            {"code": "Wait", "parameters": [15]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 15]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I trust you. I'll tell you the story... but"},
