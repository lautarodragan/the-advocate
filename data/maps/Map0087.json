          "event_commands": [
            {"code": 11030, "indent": 0, "parameters": [60, 60, 60, 0, 10, 1], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The Director of the Agency heard about"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "my skills as an educator and as a man"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "of science."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I suppose that there's a new Director"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "these days? Well, the one I knew was"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "a good man."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "He told me that in a few years, we"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "would have used up the last of our"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "planet's resources."},
            {"code": 11330, "indent": 0, "parameters": [1, 8, 0, 0, 12], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The Agency had a plan, though. They"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "would build a space station to collect"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "energy from the cosmos and channel"
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "it down to the planet in a form we could"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "use. This \"Catch Colony\" was our only"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "hope to surviving the ensuing Shortage."
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "But there was a problem. The Catch"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Colony would not be ready in time."
            },
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [1, 8, 0, 0, 2, 2], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The Agency needed some way to"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "coordinate its construction efforts."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Only maximum, superhuman efficiency"
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "would be enough to finish the project"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "in time."},
            {"code": 11330, "indent": 0, "parameters": [3, 8, 0, 0, 14], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I should never have accepted."
            },
            {"code": 11030, "indent": 0, "parameters": [0, 0, 0, 0, 10, 1], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [20], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "But, I was young, what? Probably as"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "obstinate in my support of the Agency"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "as you, little girl."},
            {"code": 10120, "indent": 0, "parameters": [1, 2, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DALIA"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "... ... ..."},
            {"code": 10120, "indent": 0, "parameters": [1, 0, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I agreed, and moved away from Yun,"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "and my family, here, to this damn"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "military complex."},
