        {
          "event_commands": [
            {"code": "TintScreen", "parameters": [60, 60, 60, 0, 10, 1]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "The Director of the Agency heard about"},
            {"code": "ShowMessage_2", "string": "my skills as an educator and as a man"},
            {"code": "ShowMessage_2", "string": "of science."},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "I suppose that there's a new Director"},
            {"code": "ShowMessage_2", "string": "these days? Well, the one I knew was"},
            {"code": "ShowMessage_2", "string": "a good man."},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "He told me that in a few years, we"},
            {"code": "ShowMessage_2", "string": "would have used up the last of our"},
            {"code": "ShowMessage_2", "string": "planet's resources."},
            {"code": "MoveEvent", "parameters": [1, 8, 0, 0, 12]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "The Agency had a plan, though. They"},
            {"code": "ShowMessage_2", "string": "would build a space station to collect"},
            {"code": "ShowMessage_2", "string": "energy from the cosmos and channel"},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "it down to the planet in a form we could"},
            {"code": "ShowMessage_2", "string": "use. This \"Catch Colony\" was our only"},
            {"code": "ShowMessage_2", "string": "hope to surviving the ensuing Shortage."},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "But there was a problem. The Catch"},
            {"code": "ShowMessage_2", "string": "Colony would not be ready in time."},
            {"code": "Wait", "parameters": [5]},
            {"code": "MoveEvent", "parameters": [1, 8, 0, 0, 2, 2]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "The Agency needed some way to"},
            {"code": "ShowMessage_2", "string": "coordinate its construction efforts."},
            {"code": "ShowMessage_2", "string": "Only maximum, superhuman efficiency"},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "would be enough to finish the project"},
            {"code": "ShowMessage_2", "string": "in time."},
            {"code": "MoveEvent", "parameters": [3, 8, 0, 0, 14]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "I should never have accepted."},
            {"code": "TintScreen", "parameters": [0, 0, 0, 0, 10, 1]},
            {"code": "Wait", "parameters": [20]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "But, I was young, what? Probably as"},
            {"code": "ShowMessage_2", "string": "obstinate in my support of the Agency"},
            {"code": "ShowMessage_2", "string": "as you, little girl."},
            {"code": "MessageOptions", "parameters": [1, 2, 0, 0]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "... ... ..."},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "I agreed, and moved away from Yun,"},
            {"code": "ShowMessage_2", "string": "and my family, here, to this damn"},
