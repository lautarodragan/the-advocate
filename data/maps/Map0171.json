            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "What?! Daddy, the Agency - !"
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I know it will be hard, Emily - but this"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "is the only way. I need you and Talan"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "to keep the dream of Paradise alive."
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [1, 8, 0, 0, 3], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Long ago, my friends and I fled from the"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Agency, and we came to this place."
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "We fled because we had something the"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Agency wanted, something it would give"
