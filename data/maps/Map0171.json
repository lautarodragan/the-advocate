            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "PIERSON"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "No, Talan. Paradise existed for one reason"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "alone - to preserve that reason, I have to"
