    {
      "id": 11,
      "name": "RunExplainScene1",
      "pages": [
        {
          "event_commands": [
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 0, 0, 0, 0]},
            {"code": "Wait", "parameters": [20]},
            {"code": "ShowMessage", "string": "OLD MAN"},
            {"code": "ShowMessage_2", "string": "Welcome to Paradise, friend. My name is"},
            {"code": "ShowMessage_2", "string": "Pierson, and these are the men and women"},
            {"code": "ShowMessage_2", "string": "of the Council."},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "TALAN"},
            {
              "code": "ShowMessage_2",
              "string": "My name is Talan.  I... can't thank you enough"
            },
            {"code": "ShowMessage_2", "string": "for saving me from the Agency."},
            {"code": "MoveEvent", "parameters": [10, 8, 0, 0, 13, 23]},
            {"code": "ShowMessage", "string": "PIERSON"},
            {
              "code": "ShowMessage_2",
              "string": "Well... you're not quite in the clear, yet... you"
            },
            {"code": "ShowMessage_2", "string": "still have to face the Trials. Allow me to"},
            {"code": "ShowMessage_2", "string": "explain."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "... ... ..."},
            {"code": "MoveEvent", "parameters": [10, 8, 0, 0, 12]},
            {"code": "Wait", "parameters": [5]},
            {"code": "TintScreen", "parameters": [0, 0, 0, 100, 5, 1]},
            {"code": "Teleport", "parameters": [175, 9, 5]}
          ],
          "id": 1,
          "move_type": "stationary",
          "trigger": "auto_start"
        },
        {
          "condition": {
            "flags": {
              "actor": false,
              "item": false,
              "switch_a": true,
              "switch_b": false,
              "timer": false,
              "variable": false
            },
            "switch_a_id": 484
          },
          "event_commands": [
            {"code": "ChangePartyMembers", "parameters": [1, 0, 10]},
            {"code": "ChangePartyMembers", "parameters": [0, 0, 14]},
            {"code": "TintScreen", "parameters": [100, 100, 100, 100, 5, 1]},
            {"code": "MoveEvent", "parameters": [10, 8, 0, 0, 14]},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "We named it \"Paradise\" and set to work"},
            {"code": "ShowMessage_2", "string": "fixing the buildings and establishing a small"},
            {"code": "ShowMessage_2", "string": "community for those out of favor with"},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "the Agency.  We have lived here ever since,"},
            {"code": "ShowMessage_2", "string": "gaining new members, losing old ones, but"},
            {"code": "ShowMessage_2", "string": "always disavowing technology and the Agency."},
            {"code": "Wait", "parameters": [20]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I don't understand - why does the Agency let"},
            {"code": "ShowMessage_2", "string": "you stay here? Why have they given up on"},
            {"code": "ShowMessage_2", "string": "their pursuit of me because I made it here?"},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "We came to an agreement with the Director"},
            {"code": "ShowMessage_2", "string": "of the Agency many, many years ago. He"},
            {"code": "ShowMessage_2", "string": "would not wish to break it."},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "... ... ..."},
            {"code": "ShowMessage", "string": "PIERSON"},
            {
              "code": "ShowMessage_2",
              "string": "But that is enough history for one day. You wish"
            },
            {"code": "ShowMessage_2", "string": "to know how you can stay here in this nirvana"},
            {"code": "ShowMessage_2", "string": "we have been given."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Um... yes. What exactly are these \"Trials?\""},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "Anyone wishing to stay in Paradise has the"},
            {
              "code": "ShowMessage_2",
              "string": "benefit of having their history erased - no one"
            },
            {"code": "ShowMessage_2", "string": "here will pry into your past."},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "However, this is not a benefit to be lightly"},
            {"code": "ShowMessage_2", "string": "given. We do not want this place to be a den"},
            {"code": "ShowMessage_2", "string": "of criminals, as the Agency considers it."},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "For this reason, anyone wishing to stay must"},
            {
              "code": "ShowMessage_2",
              "string": "complete a test of his moral fitness and strength"
            },
            {"code": "ShowMessage_2", "string": "of character."},
            {"code": "ShowMessage", "string": "PIERSON"},
            {
              "code": "ShowMessage_2",
              "string": "You will be given the Trials tomorrow morning."
            },
            {"code": "ShowMessage_2", "string": "For now, you are welcome to explore our"},
            {"code": "ShowMessage_2", "string": "community and speak with our citizens."},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "If you successfully complete tomorrow's"},
            {
              "code": "ShowMessage_2",
              "string": "Trials, you will be asked to select one of the"
            },
            {"code": "ShowMessage_2", "string": "four main professions of Paradise."},
            {"code": "ShowMessage", "string": "PIERSON"},
            {
              "code": "ShowMessage_2",
              "string": "This will establish your role in our community,"
            },
            {"code": "ShowMessage_2", "string": "so choose wisely. But for now, welcome to"},
            {"code": "ShowMessage_2", "string": "Paradise, and good luck tomorrow!"},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "Please return and speak to me when you have"},
            {"code": "ShowMessage_2", "string": "finished your explorations of our town."},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Thank you, Sir."},
            {"code": "ShowMessage", "string": "PIERSON"},
            {"code": "ShowMessage_2", "string": "Pierson will do fine, Talan. We try not to"},
            {"code": "ShowMessage_2", "string": "make very much of status in Paradise. Let"},
            {
              "code": "ShowMessage_2",
              "string": "the Agency display their ranks - it is not for us."
            },
            {"code": "ControlSwitches", "parameters": [0, 350, 350, 0]},
            {"code": "ControlSwitches", "parameters": [0, 349, 349, 0]}
