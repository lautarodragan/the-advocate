    {
      "id": 21,
      "name": "BumGuardingEntrance",
      "pages": [
        {
          "animation_type": "fixed_graphic",
          "character_index": 1,
          "character_name": "Future3",
          "event_commands": [
            {"code": "ShowMessage", "string": "PANHANDLER"},
            {"code": "ShowMessage_2", "string": "Hey there, pal. Spare some creds?"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "What did you say?"},
            {"code": "ShowMessage", "string": "PANHANDLER"},
            {"code": "ShowMessage_2", "string": "Got any loose credits you wouldn't"},
            {"code": "ShowMessage_2", "string": "mind parting with, pal?"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "... ... ..."},
            {"code": "ShowMessage", "string": "PANHANDLER"},
            {"code": "ShowMessage_2", "string": "What's with you, anyway?"},
            {"code": "ShowMessage_2", "string": "Listen, I could just use -"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "No, YOU listen!"},
            {"code": "Wait", "parameters": [2]},
            {"code": "MoveEvent", "parameters": [10005, 8, 0, 0, 24, 25]},
            {"code": "ConditionalBranch", "parameters": [0, 68, 0, 0, 0, 1]},
            {"code": "ShowMessage", "indent": 1, "string": "TALAN"},
            {
              "code": "ShowMessage_2",
              "indent": 1,
              "string": "I got to work late today, missing half"
            },
            {"code": "ShowMessage_2", "indent": 1, "string": "of an important speech by the"},
            {"code": "ShowMessage_2", "indent": 1, "string": "most important man in the world,"},
            {"code": "END", "indent": 1},
            {"code": "ElseBranch"},
            {"code": "ShowMessage", "indent": 1, "string": "TALAN"},
            {"code": "ShowMessage_2", "indent": 1, "string": "I was nearly late to work today,"},
            {"code": "ShowMessage_2", "indent": 1, "string": "almost missing a speech by the"},
            {"code": "ShowMessage_2", "indent": 1, "string": "most important man in the world,"},
            {"code": "END", "indent": 1},
            {"code": "EndBranch"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "who is now DEAD, and I am the prime"},
            {"code": "ShowMessage_2", "string": "suspect for his murder! I am hungry,"},
            {"code": "ShowMessage_2", "string": "I am tired, I am being chased by"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "the best Guards in the Agency, and you"},
            {"code": "ShowMessage_2", "string": "have the GALL to ask me for money?"},
            {"code": "PlaySound", "parameters": [100, 100, 50], "string": "Thunder9"},
            {"code": "FlashScreen", "parameters": [31, 31, 31, 31, 5, 1]},
            {"code": "ControlSwitches", "parameters": [0, 94, 94, 0]},
            {"code": "WeatherEffects", "parameters": [1, 2]},
            {"code": "Wait", "parameters": [20]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "And now I'm soaked."},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "PANHANDLER"},
            {"code": "ShowMessage_2", "string": "Gee, pal. I'm sorry. Looks like you"},
            {"code": "ShowMessage_2", "string": "need this more than I do."},
            {"code": "MessageOptions", "parameters": [1, 1, 0, 0]},
            {"code": "PlaySound", "parameters": [100, 100, 50], "string": "Item1"},
            {"code": "ChangeGold", "parameters": [0, 0, 20]},
            {"code": "ShowMessage", "string": "PANHANDLER gave TALAN 20 credits."},
            {"code": "MessageOptions", "parameters": [0, 2, 1, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Well. Thank you very much."},
            {"code": "ShowMessage", "string": "PANHANDLER"},
            {"code": "ShowMessage_2", "string": "Just a tip, pal. You won't be able to"},
            {"code": "ShowMessage_2", "string": "use the roads to get out of Sector"},
            {"code": "ShowMessage_2", "string": "30. The guys after you will have"},
            {"code": "ShowMessage", "string": "PANHANDLER"},
            {"code": "ShowMessage_2", "string": "all the exits covered. You're gonna"},
