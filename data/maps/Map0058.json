{
  "chipset_id": 11,
  "events": [
    {
      "id": 1,
      "name": "RunAuraTutorial",
      "pages": [
        {
          "character_direction": "right",
          "event_commands": [
            {"code": "MemorizeBGM"},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 13]},
            {"code": "FadeOutBGM", "parameters": [1000]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "TintScreen", "parameters": [100, 100, 100, 100, 5, 1]},
            {"code": "ShowMessage", "string": "Talan has unlocked the ability to"},
            {"code": "ShowMessage_2", "string": "sense AURAs."},
            {"code": "ShowMessage", "string": "In his Special menu, you will now find"},
            {"code": "ShowMessage_2", "string": "a DETECT AURA option."},
            {"code": "ShowMessage", "string": "Let's see how this works. First, Talan"},
            {"code": "ShowMessage_2", "string": "needs to be in combat..."},
            {"code": "ControlSwitches", "parameters": [0, 184, 184, 0]},
            {"code": "PlayBGM", "parameters": [0, 80, 100, 50], "string": "hydr"},
            {"code": "Wait", "parameters": [10]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 14]},
            {"code": "Wait", "parameters": [4]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Thanks a lot."},
            {"code": "Wait", "parameters": [3]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 13]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "Don't mention it. Anyway, now that"},
            {"code": "ShowMessage_2", "string": "Talan is in a battle, he can use"},
            {"code": "ShowMessage_2", "string": "the DETECT AURA special skill."},
            {"code": "Wait", "parameters": [5]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 24, 25]},
            {"code": "ShowBattleAnimation", "parameters": [142, 2, 1, 0]},
            {"code": "ShowBattleAnimation", "parameters": [142, 3, 1, 0]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "The two Agency Guards are giving"},
            {"code": "ShowMessage_2", "string": "off a medium BLUE aura..."},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "DETECT AURA allows you to see"},
            {"code": "ShowMessage_2", "string": "what color aura the enemies have."},
            {"code": "ShowMessage_2", "string": "In this case, a Blue aura."},
            {"code": "ShowMessage", "string": "The different color auras have various"},
            {"code": "ShowMessage_2", "string": "properties, which you will come to"},
            {"code": "ShowMessage_2", "string": "learn as you experiment with the system."},
            {"code": "ShowMessage", "string": "In addition to color, DETECT AURA"},
            {"code": "ShowMessage_2", "string": "also gives you the aura's strength."},
            {"code": "ShowMessage_2", "string": "Stronger auras are more powerful."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 14]},
            {"code": "Wait", "parameters": [4]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "So what is this good for?"},
            {"code": "Wait", "parameters": [3]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "I'm getting to that. Once you have"},
            {"code": "ShowMessage_2", "string": "detected the enemies' aura, you"},
            {"code": "ShowMessage_2", "string": "gain a new skill: ABSORB AURA."},
            {"code": "ShowMessage", "string": "By using the ABSORB AURA skill,"},
            {"code": "ShowMessage_2", "string": "you can steal techniques which you"},
            {"code": "ShowMessage_2", "string": "can then use against the enemies!"},
            {"code": "ShowMessage", "string": "The skills you receive are dependant"},
            {"code": "ShowMessage_2", "string": "upon the color and strength of the"},
            {"code": "ShowMessage_2", "string": "aura."},
            {"code": "ShowMessage", "string": "Why don't you try it, Talan?"},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Don't mind if I do."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 13]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowBattleAnimation", "parameters": [143, 2, 0, 0]},
            {"code": "Wait", "parameters": [3]},
            {"code": "ShowBattleAnimation", "parameters": [143, 3, 1, 0]},
            {"code": "ShowMessage", "string": "TALAN absorbed techniques from"},
            {"code": "ShowMessage_2", "string": "the aura of the Agency Guards..."},
            {"code": "Wait", "parameters": [3]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "So, what did you get?"},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 14]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "Snazzbanger! I got some healing spells,"},
            {"code": "ShowMessage_2", "string": "a spell to raise my attack power, and"},
            {"code": "ShowMessage_2", "string": "an attacking spell! This is great!"},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I get to keep these from now on, right?"},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "Um..... no, not exactly. Any skills you"},
            {"code": "ShowMessage_2", "string": "absorb go away at the end of the"},
            {"code": "ShowMessage_2", "string": "battle."},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "What?!"},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "Sorry about that. Absorbed skills only"},
            {"code": "ShowMessage_2", "string": "stay for the duration of the battle."},
            {"code": "ShowMessage", "string": "But - if you absorb a certain skill enough"},
            {"code": "ShowMessage_2", "string": "times, eventually, you'll have it for good."},
            {"code": "ShowMessage_2", "string": "But the more powerful the skill, the"},
            {"code": "ShowMessage_2", "string": "longer it'll take to learn permanently."},
            {"code": "ShowMessage", "string": "You can use the Portable Console item"},
            {"code": "ShowMessage_2", "string": "to bring up a menu that lets you see how"},
            {"code": "ShowMessage_2", "string": "often you have absorbed certain aura"},
            {"code": "ShowMessage_2", "string": "abilities, but only when not in combat."},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "OK, I think I understand how to use"},
            {"code": "ShowMessage_2", "string": "auras now. These Agency Guards"},
            {"code": "ShowMessage_2", "string": "are going to be feeling some pain!"},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "Don't get too confident, Talan. It"},
            {"code": "ShowMessage_2", "string": "still takes two turns before you have"},
            {"code": "ShowMessage_2", "string": "aura skills at your disposal. You need"},
            {"code": "ShowMessage_2", "string": "to be cautious."},
            {"code": "ShowMessage", "string": "Good luck! (You'll need it!)"},
            {"code": "MessageOptions", "parameters": [0, 0, 1, 0]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 15]},
            {"code": "PlayMemorizedBGM"},
            {"code": "RecallToLocation", "parameters": [127, 128, 129]}
          ],
          "id": 1,
          "move_type": "stationary",
          "trigger": "auto_start"
        }
      ]
