            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Will you stop that, little girl?"},
            {
              "code": "MoveEvent",
              "parameters": [10001, 8, 0, 0, 36, 24, 25, 3, 3, 3, 3, 3, 3, 0, 0, 15, 37]
            },
            {"code": "Wait", "parameters": [20]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "I am a Corporal in the most powerful"},
            {"code": "ShowMessage_2", "string": "organization - "},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Oh, hush. I heard you the first time."},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Can't an old man relax in his retirement?"},
            {"code": "ShowMessage_2", "string": "What's the world coming to? Me, oh my."},
            {"code": "ShowMessage_2", "string": "Harumph!"},
            {"code": "MoveEvent", "parameters": [4, 4, 0, 0, 2, 13]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "You're in my way."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 29, 26, 1, 27, 28]},
            {"code": "Wait", "parameters": [10]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "Why am I letting him get away with"},
            {"code": "ShowMessage_2", "string": "talking to me like this?"},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "He's just an old man. That must be it."},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "MoveEvent", "parameters": [4, 8, 0, 0, 1, 2, 1, 2, 2, 12]},
            {"code": "Wait", "parameters": [20]},
            {"code": "MessageOptions", "parameters": [0, 0, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Why should I reactivate the Advocate?"},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 14]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "Because the Agency has ordered you to."},
            {"code": "ShowMessage_2", "string": "It is your solemn duty to carry out -"},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Bah. So they sent me a dyed-in-the-wool"},
            {"code": "ShowMessage_2", "string": "spear carrier, eh? What?"},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "What's that supposed to mean?"},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Just an old expression. You probably"},
            {"code": "ShowMessage_2", "string": "wouldn't understand. I suppose you'd"},
            {"code": "ShowMessage_2", "string": "be \"loyal to the last,\" for this wonderful"},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Agency of yours, eh? What?"},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "Of course! Serving the Agency is the"},
            {"code": "ShowMessage_2", "string": "greatest honor anyone could hope for!"},
            {"code": "ShowMessage_2", "string": "And promotion to the Catch Colony is"},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "the highest reward for those whose"},
            {"code": "ShowMessage_2", "string": "hearts are most loyal!"},
            {"code": "Wait", "parameters": [10]},
            {"code": "MoveEvent", "parameters": [4, 8, 0, 0, 13]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "So they built the damn thing. Bah."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 2]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "How dare you besmirch - "},
            {"code": "MoveEvent", "parameters": [4, 8, 0, 0, 12]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Settle down, little girl. My, you"},
            {"code": "ShowMessage_2", "string": "certainly are excitable. I can"},
            {"code": "ShowMessage_2", "string": "criticize the Agency all I like -"},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Lord knows they've criticized me"},
            {"code": "ShowMessage_2", "string": "enough, in my day. Eh?"},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "This old man is off his rocker. I think"},
            {"code": "ShowMessage_2", "string": "he's been in one simulation too many."},
            {"code": "MessageOptions", "parameters": [0, 0, 0, 0]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "Just turn on this Advocate thing and I'll"},
            {"code": "ShowMessage_2", "string": "leave you to your simulation."},
            {"code": "MoveEvent", "parameters": [4, 8, 0, 0, 14]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Kids. Always so eager to finish their"},
            {"code": "ShowMessage_2", "string": "chores so they can run and play."},
            {"code": "ShowMessage_2", "string": "Harumph!"},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "I am NOT a -"},
            {"code": "MoveEvent", "parameters": [4, 8, 0, 0, 12]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Do you even know what the Advocate"},
            {"code": "ShowMessage_2", "string": "is? Have your superiors even told you"},
            {"code": "ShowMessage_2", "string": "that much?"},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "Well... it's a computer program that... was"},
            {"code": "ShowMessage_2", "string": "built to assist construction of the Catch"},
            {"code": "ShowMessage_2", "string": "Colony, back before the Shortage."},
            {"code": "MoveEvent", "parameters": [4, 8, 0, 0, 1, 1, 1]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "... ... ..."},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "I think I'm going to tell you my story."},
            {"code": "ShowMessage_2", "string": "If you still want me to reactivate the"},
            {"code": "ShowMessage_2", "string": "Advocate once I've finished..."},
            {"code": "Wait", "parameters": [10]},
            {"code": "MoveEvent", "parameters": [4, 8, 0, 0, 15]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "So be it."},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 2, 2, 13]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "DALIA"},
            {"code": "ShowMessage_2", "string": "Fine. I'll listen to your story. But make"},
            {"code": "ShowMessage_2", "string": "it quick."},
            {"code": "Wait", "parameters": [10]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "My story begins before the Shortage,"},
            {"code": "ShowMessage_2", "string": "back when I was a young man..."},
