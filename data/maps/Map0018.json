            [0, "PlayBGM", "Astpgmarch", [1000, 40, 70, 50]],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "Greetings, workers of Delcentric Factory", []],
            [0, "ShowMessage_2", "#2072, Lashe City. It is an honor and a", []],
            [0, "ShowMessage_2", "privilege to speak to you today.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "Delcentric is one of the most valuable", []],
