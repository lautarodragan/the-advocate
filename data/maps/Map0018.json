    {
      "id": 36,
      "name": "EV0036",
      "pages": [
        {
          "condition": {
            "flags": {
              "actor": false,
              "item": false,
              "switch_a": true,
              "switch_b": false,
              "timer": false,
              "variable": false
            },
            "switch_a_id": 77
          },
          "event_commands": [
            {"code": "ChangeEventLocation", "parameters": [16, 0, 10, 14]},
            {"code": "ControlSwitches", "parameters": [0, 86, 86, 0]},
            {"code": "MoveEvent", "parameters": [16, 8, 0, 0, 0, 0, 0, 0, 1, 1, 1, 12]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ChangeEventLocation", "parameters": [9, 0, 8, 14]},
            {"code": "ControlSwitches", "parameters": [0, 87, 87, 0]},
            {"code": "MoveEvent", "parameters": [9, 8, 0, 0, 0, 0, 0, 0, 0, 0, 3, 3, 12]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "I'd better find a seat - this place is"},
            {"code": "ShowMessage_2", "string": "filling up!"},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 0, 0, 3, 3, 3, 12, 23, 23, 15]},
            {"code": "Wait", "parameters": [12]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "How'd you get here before me, Dess?"},
            {"code": "MoveEvent", "parameters": [37, 8, 0, 0, 13]},
            {"code": "Wait", "parameters": [5]},
            {"code": "FadeOutBGM", "parameters": [2000]},
            {"code": "ShowMessage", "string": "DESSEN"},
            {"code": "ShowMessage_2", "string": "I dunno - I just did. Quiet, it's about to"},
            {"code": "ShowMessage_2", "string": "start!"},
            {"code": "MoveEvent", "parameters": [37, 8, 0, 0, 12]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 12]},
            {"code": "Wait", "parameters": [5]},
            {"code": "TintScreen", "parameters": [100, 100, 100, 100, 10, 1]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "VOICE"},
            {"code": "ShowMessage_2", "string": "Ladies and gentlemen of Delcentric"},
            {"code": "ShowMessage_2", "string": "Factory #2072, Lashe City..."},
            {"code": "ShowMessage", "string": "VOICE"},
            {"code": "ShowMessage_2", "string": "The Director of the Agency!"},
            {"code": "Wait", "parameters": [10]},
            {"code": "PlaySound", "parameters": [40, 100, 50], "string": "Wind1"},
            {"code": "ControlSwitches", "parameters": [0, 88, 88, 0]},
            {"code": "Wait", "parameters": [3]},
            {"code": "PlaySound", "parameters": [70, 100, 50], "string": "clap"},
            {"code": "Wait", "parameters": [14]},
            {"code": "PlayBGM", "parameters": [1000, 40, 70, 50], "string": "Astpgmarch"},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "Greetings, workers of Delcentric Factory"},
            {"code": "ShowMessage_2", "string": "#2072, Lashe City. It is an honor and a"},
            {"code": "ShowMessage_2", "string": "privilege to speak to you today."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "Delcentric is one of the most valuable"},
            {"code": "ShowMessage_2", "string": "subsidiary corporations in the world"},
            {"code": "ShowMessage_2", "string": "today, and we owe it all to you."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "Without your hard work and dedication,"},
            {"code": "ShowMessage_2", "string": "the energy we obtain from the Catch"},
            {"code": "ShowMessage_2", "string": "Colony would be useless!"},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "You deserve congratulations, and that"},
            {"code": "ShowMessage_2", "string": "is one of the reasons I am here today."},
            {"code": "Wait", "parameters": [10]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 15]},
            {"code": "MoveEvent", "parameters": [37, 8, 0, 0, 13]},
            {"code": "Wait", "parameters": [5]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "See - good news so far!"},
            {"code": "ShowMessage", "string": "DESSEN"},
            {"code": "ShowMessage_2", "string": "Sshhh!"},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 12]},
            {"code": "MoveEvent", "parameters": [37, 8, 0, 0, 12]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "Wait", "parameters": [8]},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "As a reward for your hard work, I"},
            {"code": "ShowMessage_2", "string": "and the rest of Agency High Command"},
            {"code": "ShowMessage_2", "string": "have made a decision."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "From this day forth, all Delcentric"},
            {"code": "ShowMessage_2", "string": "Employees will have permission to"},
            {"code": "ShowMessage_2", "string": "stay at Agency Houses."},
            {"code": "PlaySound", "parameters": [70, 100, 50], "string": "clap"},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "As I am sure you all know, Agency"},
            {"code": "ShowMessage_2", "string": "Houses are luxurious abodes that"},
            {"code": "ShowMessage_2", "string": "were previously only for the wealthy."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "But now - they are open to you, the"},
            {"code": "ShowMessage_2", "string": "valuable workers of Delcentric Factory"},
            {"code": "ShowMessage_2", "string": "#2072, Lashe City."},
            {"code": "PlaySound", "parameters": [70, 70, 50], "string": "clap"},
            {"code": "Wait", "parameters": [30]},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "I remember the stories my Granddad"},
            {"code": "ShowMessage_2", "string": "told me when I was just a boy, of the"},
            {"code": "ShowMessage_2", "string": "terrible time of the Shortage."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "Our natural resources had been"},
            {"code": "ShowMessage_2", "string": "depleted. Something needed to be"},
            {"code": "ShowMessage_2", "string": "done."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "My Granddad, I am proud to say, was"},
            {"code": "ShowMessage_2", "string": "part of the solution. He and a team"},
            {"code": "ShowMessage_2", "string": "of scientists began an epic project."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "Since our reservoirs of natural gas and"},
            {"code": "ShowMessage_2", "string": "crude oil had been used up, we would"},
            {"code": "ShowMessage_2", "string": "need a new form of power."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "For that power, we turned to the"},
            {"code": "ShowMessage_2", "string": "heavens."},
            {"code": "Wait", "parameters": [10]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 15]},
            {"code": "Wait", "parameters": [5]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "TALAN"},
            {"code": "ShowMessage_2", "string": "We know all this already!"},
            {"code": "MoveEvent", "parameters": [37, 8, 0, 0, 13]},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "DESSEN"},
            {"code": "ShowMessage_2", "string": "Quiet, Talan!"},
            {"code": "Wait", "parameters": [3]},
            {"code": "MoveEvent", "parameters": [10001, 8, 0, 0, 12]},
            {"code": "MoveEvent", "parameters": [37, 8, 0, 0, 12]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "Thus, the Catch Colony was born."},
            {"code": "ShowMessage_2", "string": "A tremendous space station that"},
            {"code": "ShowMessage_2", "string": "would serve to collect cosmic energy"},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "and relay it down to earth where it"},
