            [0, "MoveEvent", "", [10001, 8, 0, 0, 12]],
            [0, "MoveEvent", "", [37, 8, 0, 0, 12]],
            [0, "MessageOptions", "", [0, 2, 0, 0]],
            [0, "Wait", "", [8]],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "As a reward for your hard work, I", []],
            [0, "ShowMessage_2", "and the rest of Agency High Command", []],
            [0, "ShowMessage_2", "have made a decision.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "From this day forth, all Delcentric", []],
            [0, "ShowMessage_2", "Employees will have permission to", []],
            [0, "ShowMessage_2", "stay at Agency Houses.", []],
            [0, "PlaySound", "clap", [70, 100, 50]],
            [0, "Wait", "", [10]],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "As I am sure you all know, Agency", []],
            [0, "ShowMessage_2", "Houses are luxurious abodes that", []],
            [0, "ShowMessage_2", "were previously only for the wealthy.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "But now - they are open to you, the", []],
            [0, "ShowMessage_2", "valuable workers of Delcentric Factory", []],
            [0, "ShowMessage_2", "#2072, Lashe City.", []],
            [0, "PlaySound", "clap", [70, 70, 50]],
            [0, "Wait", "", [30]],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "I remember the stories my Granddad", []],
            [0, "ShowMessage_2", "told me when I was just a boy, of the", []],
            [0, "ShowMessage_2", "terrible time of the Shortage.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "Our natural resources had been", []],
            [0, "ShowMessage_2", "depleted. Something needed to be", []],
            [0, "ShowMessage_2", "done.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "My Granddad, I am proud to say, was", []],
            [0, "ShowMessage_2", "part of the solution. He and a team", []],
            [0, "ShowMessage_2", "of scientists began an epic project.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "Since our reservoirs of natural gas and", []],
            [0, "ShowMessage_2", "crude oil had been used up, we would", []],
            [0, "ShowMessage_2", "need a new form of power.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "For that power, we turned to the", []],
            [0, "ShowMessage_2", "heavens.", []],
            [0, "Wait", "", [10]],
            [0, "MoveEvent", "", [10001, 8, 0, 0, 15]],
            [0, "Wait", "", [5]],
            [0, "MessageOptions", "", [1, 0, 0, 0]],
            [0, "ShowMessage", "TALAN", []],
            [0, "ShowMessage_2", "We know all this already!", []],
            [0, "MoveEvent", "", [37, 8, 0, 0, 13]],
            [0, "Wait", "", [5]],
            [0, "ShowMessage", "DESSEN", []],
            [0, "ShowMessage_2", "Quiet, Talan!", []],
            [0, "Wait", "", [3]],
            [0, "MoveEvent", "", [10001, 8, 0, 0, 12]],
            [0, "MoveEvent", "", [37, 8, 0, 0, 12]],
            [0, "MessageOptions", "", [0, 2, 0, 0]],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "Thus, the Catch Colony was born.", []],
            [0, "ShowMessage_2", "A tremendous space station that", []],
            [0, "ShowMessage_2", "would serve to collect cosmic energy", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "and relay it down to earth where it", []],
            [0, "ShowMessage_2", "could be converted into the power", []],
            [0, "ShowMessage_2", "needed to run our society.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "The thousands of men and women who", []],
            [0, "ShowMessage_2", "live on the Catch Colony deserve", []],
            [0, "ShowMessage_2", "our utmost thanks... but so do you.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "Without Delcentric and its fellow", []],
            [0, "ShowMessage_2", "companies, their sacrifices would be", []],
            [0, "ShowMessage_2", "in vain.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "My Granddad's vision has come to", []],
            [0, "ShowMessage_2", "pass. And I, as leader of the Agency,", []],
            [0, "ShowMessage_2", "supreme governing body of our", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "society, will continue to make the", []],
            [0, "ShowMessage_2", "RIGHT decisions, for you and your", []],
            [0, "ShowMessage_2", "families.", []],
            [0, "ShowMessage", "DIRECTOR", []],
            [0, "ShowMessage_2", "Workers of Delcentric Factory #2072,", []],
            [0, "ShowMessage_2", "you have made me proud. Let me now", []],
            [0, "ShowMessage_2", "make you proud. Thank you.", []],
