          "event_commands": [
            {"code": 11030, "indent": 0, "parameters": [100, 100, 100, 100, 5, 1], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [0, 2, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "ISABELLA"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Drago... what's wrong? Why are you"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "so upset?"},
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "SERN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "What did they ask you?"},
            {"code": 11410, "indent": 0, "parameters": [20], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I don't think I'm cut out to be part"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "of the Agency."},
            {"code": 11330, "indent": 0, "parameters": [9, 8, 0, 0, 24, 25], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [11, 8, 0, 0, 23, 24, 25], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "ISABELLA"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Drago... what do you mean?"
            },
            {"code": 11330, "indent": 0, "parameters": [8, 8, 0, 0, 13], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The examiners told me that you two"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "passed the exam with flying colors."
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "Not a single penalty."},
            {"code": 11330, "indent": 0, "parameters": [9, 8, 0, 0, 24, 25], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "SERN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Really? That's great!"},
            {"code": 11410, "indent": 0, "parameters": [15], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "ISABELLA"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Drago... what did they ask you?"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "Did you pass too?"},
            {"code": 11330, "indent": 0, "parameters": [8, 8, 0, 0, 14], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "They asked me what I would do if"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "you two were trapped inside that"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "building with a wanted terrorist."
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "They said the terrorist would remotely"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "launch a nuclear device if he was not"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "dispatched immediately."},
            {"code": 11330, "indent": 0, "parameters": [8, 8, 0, 0, 13], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "\"What would you do?\" they asked me."
            },
            {"code": 11410, "indent": 0, "parameters": [30], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "SERN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "What did you say? You said you'd take"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "out the building and kill the terrorist"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "immediately, right?"},
            {"code": 11410, "indent": 0, "parameters": [20], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "... ... ..."},
            {"code": 11330, "indent": 0, "parameters": [8, 8, 0, 0, 14], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The Agency doesn't care about its"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "individual members. I couldn't sacrifice"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "two of my friends for the greater good!"
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I refuse to be put in that position!"
            },
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DRAGO"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I need to leave. I need to leave tonight."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I'm not sure what the Agency does to"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "people who fail the exam -"
            },
            {"code": 11410, "indent": 0, "parameters": [2], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "ISABELLA"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I'm coming with you. Wherever you"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "go. We don't need to join the Agency!"
            },
            {"code": 11410, "indent": 0, "parameters": [2], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [9, 8, 0, 0, 24, 25], "string": ""},
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "SERN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "This is crazy!"},
            {
              "code": 11330,
              "indent": 0,
              "parameters": [12, 8, 0, 0, 28, 2, 2, 2, 2, 2, 2, 2, 2, 2, 29],
              "string": ""
            },
            {"code": 11340, "indent": 0, "parameters": [], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DALIA"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Drago! There you are! Can you believe"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "how easy the squad leader exam was?"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I thought it would be so much harder!"
            },
            {"code": 11030, "indent": 0, "parameters": [0, 0, 0, 100, 5, 1], "string": ""},
            {"code": 10210, "indent": 0, "parameters": [0, 934, 934, 0], "string": ""},
