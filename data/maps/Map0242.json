            {"code": "MoveEvent", "parameters": [8, 8, 0, 0, 13]},
            {"code": "ProceedWithMovement"},
            {"code": "ShowMessage", "string": "DRAGO"},
            {"code": "ShowMessage_2", "string": "\"What would you do?\" they asked me."},
