            {"code": "MoveEvent", "parameters": [8, 8, 0, 0, 14]},
            {"code": "ProceedWithMovement"},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "DRAGO"},
            {"code": "ShowMessage_2", "string": "They asked me what I would do if"},
            {"code": "ShowMessage_2", "string": "you two were trapped inside that"},
