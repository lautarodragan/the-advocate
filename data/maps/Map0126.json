          "event_commands": [
            {"code": 10120, "indent": 0, "parameters": [0, 2, 0, 0], "string": ""},
            {
              "code": 11330,
              "indent": 0,
              "parameters": [10001, 8, 0, 0, 0, 1, 1, 1],
              "string": ""
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "I hear you there, Talan."},
            {"code": 11410, "indent": 0, "parameters": [30], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [5, 8, 0, 0, 15], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [20], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "So."},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Your father told me you said you were"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "picking flowers."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Well... let's just put this all behind us, OK?"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "It's not important."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Emily, it IS important. How do I know"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "you're not going to come up here tonight"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "and throw yourself off?"},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I might not be here the next time!"
            },
            {"code": 11330, "indent": 0, "parameters": [5, 8, 0, 0, 13], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "You're crazy, Talan."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "What?"},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Here you are telling me to be more careful,"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "but you're the one who's been passed out"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "for the last four days!"},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Heh... you're right."},
            {"code": 11330, "indent": 0, "parameters": [5, 8, 0, 0, 3], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "So, tonight's the celebration to welcome you"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "to Paradise. You excited?"
            },
            {
              "code": 11330,
              "indent": 0,
              "parameters": [10001, 8, 0, 0, 14, 23, 23, 13],
              "string": ""
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Well, yes, I guess. I need to choose a"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "profession, right? I wonder what I should"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "choose."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Choose whatever you think you'd be"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "best at."},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Something tells me there isn't a job for"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "\"Falling from great heights.\""
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "So you do that for every girl you meet?"
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Well..."},
            {"code": 11330, "indent": 0, "parameters": [5, 8, 0, 0, 3], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I bet you have bruises from cliffs all over the"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "world, breaking your bones and the hearts"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "of girls everywhere."},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {
              "code": 11330,
              "indent": 0,
              "parameters": [5, 8, 0, 0, 34, 5, 101, 109, 105, 108, 121, 5],
              "string": ""
            },
            {"code": 11410, "indent": 0, "parameters": [20], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [1, 0, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "She's closed her eyes?"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "She's waiting for something...?"
            },
            {"code": 11410, "indent": 0, "parameters": [30], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Is she waiting for me to kiss her??"
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [10001, 8, 0, 0, 0], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {
              "code": 11330,
              "indent": 0,
              "parameters": [5, 8, 0, 0, 34, 5, 101, 109, 105, 108, 121, 4, 24, 25],
              "string": ""
            },
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {
              "code": 11330,
              "indent": 0,
              "parameters": [5, 8, 0, 0, 28, 3, 3, 3, 3, 13],
              "string": ""
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [0, 2, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EMILY"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Or maybe you really ARE as clueless"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "as you seem to be!"},
            {
              "code": 11330,
              "indent": 0,
              "parameters": [
                5, 8, 0, 0, 2, 2, 3, 3, 3, 24, 36, 38, 2, 2, 2, 2, 2, 39, 25, 37, 35, 5, 66,
                108, 111, 119, 50, 30, 100, 50, 2, 29
              ],
              "string": ""
            },
            {"code": 11410, "indent": 0, "parameters": [20], "string": ""},
            {"code": 10210, "indent": 0, "parameters": [0, 380, 380, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "She sounded angry."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I should go find her and apologize..."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "...for whatever the heck I've done now."
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "TALAN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Women."}
