      "name": "EV0004",
      "pages": [
        {
          "event_commands": [
            {"code": "TintScreen", "parameters": [60, 60, 60, 0, 10, 1]},
            {"code": "Wait", "parameters": [10]},
            {"code": "MessageOptions", "parameters": [1, 1, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "Sometimes, upon waking up in the morning,"},
            {"code": "ShowMessage_2", "string": "I would discover that whole sections of"},
            {"code": "ShowMessage_2", "string": "code had been rewritten during the night,"},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "and often, I'd have no idea what the"},
            {"code": "ShowMessage_2", "string": "new blocks of code were for."},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "The Advocate was developing a personality,"},
            {"code": "ShowMessage_2", "string": "one that I hadn't coded for it."},
            {"code": "Wait", "parameters": [10]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "I'm going to need to fix your Trans-Net"},
            {"code": "ShowMessage_2", "string": "A3G mode. Locate the thirty-fourth"},
            {"code": "ShowMessage_2", "string": "access block, Advocate."},
            {"code": "Wait", "parameters": [10]},
            {"code": "ControlSwitches", "parameters": [0, 286, 286, 2]},
            {"code": "ShowMessage", "string": "ADVOCATE"},
            {"code": "ShowMessage_2", "string": "No."},
            {"code": "ControlSwitches", "parameters": [0, 286, 286, 2]},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "I'm not joking, Advocate! Open the access"},
            {"code": "ShowMessage_2", "string": "block!"},
            {"code": "ControlSwitches", "parameters": [0, 286, 286, 2]},
            {"code": "ShowMessage", "string": "ADVOCATE"},
            {"code": "ShowMessage_2", "string": "Why should I?"},
            {"code": "ControlSwitches", "parameters": [0, 286, 286, 2]},
            {"code": "MessageOptions", "parameters": [1, 1, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "For some reason, my world-saving"},
            {"code": "ShowMessage_2", "string": "construction supervisor had turned into"},
            {"code": "ShowMessage_2", "string": "a spoiled child."},
            {"code": "ControlSwitches", "parameters": [0, 287, 287, 0]},
            {"code": "Wait", "parameters": [10]},
            {"code": "MoveEvent", "parameters": [3, 8, 0, 0, 14]},
            {"code": "MessageOptions", "parameters": [1, 0, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "But, my pride prevented me from telling"},
            {"code": "ShowMessage_2", "string": "the Director, for fear that I would be"},
            {"code": "ShowMessage_2", "string": "laughed right out of Tasgarde."},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "I had abandoned my family for this project,"},
            {"code": "ShowMessage_2", "string": "and I wasn't about to give it up because"},
            {"code": "ShowMessage_2", "string": "of a faulty AI subroutine."},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "No problems here, Sir! Everything is"},
            {"code": "ShowMessage_2", "string": "just fine!"},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "Good. I have a speech to make tonight."},
            {"code": "ShowMessage_2", "string": "I'm planning on unveiling the Advocate"},
            {"code": "ShowMessage_2", "string": "to the world."},
            {"code": "ShowMessage", "string": "DIRECTOR"},
            {"code": "ShowMessage_2", "string": "You'll be famous, Professor!"},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "... ... ..."},
            {"code": "ControlSwitches", "parameters": [0, 287, 287, 1]},
            {"code": "MessageOptions", "parameters": [1, 1, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
            {"code": "ShowMessage_2", "string": "I didn't want to be famous."},
            {"code": "Wait", "parameters": [20]},
            {"code": "MessageOptions", "parameters": [0, 2, 0, 0]},
            {"code": "ControlSwitches", "parameters": [0, 286, 286, 2]},
            {"code": "ShowMessage", "string": "ADVOCATE"},
            {"code": "ShowMessage_2", "string": "Will I be famous too?"},
            {"code": "ControlSwitches", "parameters": [0, 286, 286, 2]},
            {"code": "Wait", "parameters": [10]},
            {"code": "MoveEvent", "parameters": [3, 8, 0, 0, 12]},
            {"code": "Wait", "parameters": [5]},
            {"code": "MessageOptions", "parameters": [1, 1, 0, 0]},
            {"code": "ShowMessage", "string": "EISEN"},
