          "event_commands": [
            {"code": 11030, "indent": 0, "parameters": [60, 60, 60, 0, 10, 1], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [1, 1, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Sometimes, upon waking up in the morning,"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I would discover that whole sections of"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "code had been rewritten during the night,"
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "and often, I'd have no idea what the"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "new blocks of code were for."
            },
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "The Advocate was developing a personality,"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "one that I hadn't coded for it."
            },
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [0, 2, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I'm going to need to fix your Trans-Net"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "A3G mode. Locate the thirty-fourth"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "access block, Advocate."},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10210, "indent": 0, "parameters": [0, 286, 286, 2], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "ADVOCATE"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "No."},
            {"code": 10210, "indent": 0, "parameters": [0, 286, 286, 2], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I'm not joking, Advocate! Open the access"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "block!"},
            {"code": 10210, "indent": 0, "parameters": [0, 286, 286, 2], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "ADVOCATE"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Why should I?"},
            {"code": 10210, "indent": 0, "parameters": [0, 286, 286, 2], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [1, 1, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "For some reason, my world-saving"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "construction supervisor had turned into"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "a spoiled child."},
            {"code": 10210, "indent": 0, "parameters": [0, 287, 287, 0], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [3, 8, 0, 0, 14], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [1, 0, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "But, my pride prevented me from telling"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "the Director, for fear that I would be"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "laughed right out of Tasgarde."
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I had abandoned my family for this project,"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "and I wasn't about to give it up because"
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "of a faulty AI subroutine."
            },
            {"code": 10120, "indent": 0, "parameters": [0, 2, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "No problems here, Sir! Everything is"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "just fine!"},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DIRECTOR"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Good. I have a speech to make tonight."
            },
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I'm planning on unveiling the Advocate"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "to the world."},
            {"code": 10110, "indent": 0, "parameters": [], "string": "DIRECTOR"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "You'll be famous, Professor!"
            },
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "... ... ..."},
            {"code": 10210, "indent": 0, "parameters": [0, 287, 287, 1], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [1, 1, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "I didn't want to be famous."
            },
            {"code": 11410, "indent": 0, "parameters": [20], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [0, 2, 0, 0], "string": ""},
            {"code": 10210, "indent": 0, "parameters": [0, 286, 286, 2], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "ADVOCATE"},
            {"code": 20110, "indent": 0, "parameters": [], "string": "Will I be famous too?"},
            {"code": 10210, "indent": 0, "parameters": [0, 286, 286, 2], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [10], "string": ""},
            {"code": 11330, "indent": 0, "parameters": [3, 8, 0, 0, 12], "string": ""},
            {"code": 11410, "indent": 0, "parameters": [5], "string": ""},
            {"code": 10120, "indent": 0, "parameters": [1, 1, 0, 0], "string": ""},
            {"code": 10110, "indent": 0, "parameters": [], "string": "EISEN"},
            {
              "code": 20110,
              "indent": 0,
              "parameters": [],
              "string": "Suddenly, I hated the Advocate very"
            },
            {"code": 20110, "indent": 0, "parameters": [], "string": "much."},
