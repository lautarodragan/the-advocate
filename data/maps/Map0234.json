          "script": [
            [0, "TintScreen", "", [100, 100, 100, 100, 10, 1]],
            [0, "Wait", "", [15]],
            [0, "MessageOptions", "", [0, 0, 0, 0]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "Are you feeling better?", []],
            [0, "Wait", "", [20]],
            [0, "ShowMessage", "TALAN", []],
            [0, "ShowMessage_2", "Yeah... yeah, I'm all right. Just a little", []],
            [0, "ShowMessage_2", "dazed, I guess. Kind of dizzy...", []],
            [0, "ShowMessage", "EMILY", []],
            [0, "ShowMessage_2", "What's going on? What did you do", []],
            [0, "ShowMessage_2", "to Talan?!", []],
            [0, "Wait", "", [15]],
            [0, "PlayBGM", "elf2", [0, 100, 100, 50]],
            [0, "MoveEvent", "", [2, 8, 0, 0, 15]],
            [0, "Wait", "", [30]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "Many, many years ago, I came across", []],
            [0, "ShowMessage_2", "a band of survivors from the ruins of the", []],
            [0, "ShowMessage_2", "Kingdom of Surl.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "They were half-starved and close to", []],
            [0, "ShowMessage_2", "death. They had struggled to survive", []],
            [0, "ShowMessage_2", "in the wilderness during the years", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "following the destruction of Surl, but", []],
            [0, "ShowMessage_2", "had descended almost to the level of", []],
            [0, "ShowMessage_2", "beasts.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "They were terribly sick, from all sorts of", []],
            [0, "ShowMessage_2", "diseases, and many had severe cases", []],
            [0, "ShowMessage_2", "of radiation poisoning.", []],
            [0, "MoveEvent", "", [2, 8, 0, 0, 13]],
            [0, "Wait", "", [10]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "But there was one man who had", []],
            [0, "ShowMessage_2", "retained his sanity. He called himself", []],
            [0, "ShowMessage_2", "the Keeper of Memories.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "Somehow, the Keeper had the power", []],
            [0, "ShowMessage_2", "to take the memories of others for his", []],
            [0, "ShowMessage_2", "own.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "He had wandered all throughout the", []],
            [0, "ShowMessage_2", "ruins of Surl, finding the survivors and", []],
            [0, "ShowMessage_2", "absorbing their memories.", []],
            [0, "MoveEvent", "", [2, 8, 0, 0, 3, 3]],
            [0, "Wait", "", [20]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "Within his mind, the Keeper stored", []],
            [0, "ShowMessage_2", "all of the memories of Surl, so that when", []],
            [0, "ShowMessage_2", "the final survivor died, the memory of", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "the kingdom would live on within", []],
            [0, "ShowMessage_2", "the Keeper's mind.", []],
            [0, "MoveEvent", "", [2, 8, 0, 0, 2, 2]],
            [0, "Wait", "", [15]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "But the Keeper was dying. He had", []],
            [0, "ShowMessage_2", "been present at the time Surl was", []],
            [0, "ShowMessage_2", "destroyed, and although his sickness", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "was slower than it was for most,", []],
            [0, "ShowMessage_2", "he did not have long to live, and", []],
            [0, "ShowMessage_2", "Surl would die with him.", []],
            [0, "MoveEvent", "", [2, 8, 0, 0, 13]],
            [0, "Wait", "", [20]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "He chose... no... I volunteered...", []],
            [0, "ShowMessage_2", "to receive the memories he had absorbed.", []],
            [0, "ShowMessage_2", "The memories of an entire kingdom.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "He placed his fingertips on my forehead,", []],
            [0, "ShowMessage_2", "and I collapsed. I awoke sometime later,", []],
            [0, "ShowMessage_2", "with the Keeper dead beside me.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "I had become the new Keeper of", []],
            [0, "ShowMessage_2", "Memories, and by doing so, all memory", []],
            [0, "ShowMessage_2", "of who I was before... vanished.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "I lost my own history, but gained that", []],
            [0, "ShowMessage_2", "of a doomed nation. The survivors brought", []],
            [0, "ShowMessage_2", "me, still swooning, back to this place.", []],
            [0, "Wait", "", [10]],
            [0, "ShowMessage", "EMILY", []],
            [0, "ShowMessage_2", "But what does this have to do with -", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "It's so lonely here - I wanted to see the", []],
            [0, "ShowMessage_2", "things you've all seen, experience your", []],
            [0, "ShowMessage_2", "experiences. I wanted to feel Hope.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "Hope is something no one in Surl", []],
            [0, "ShowMessage_2", "possessed: only despair, fear, sadness,", []],
            [0, "ShowMessage_2", "and hatred. It is a heavy burden I bear.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "I opened a Memory Pathway to Talan's", []],
            [0, "ShowMessage_2", "mind, but he followed it BACK, to me...", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "And in the split second before I was", []],
            [0, "ShowMessage_2", "able to shut down the Pathway, he", []],
            [0, "ShowMessage_2", "glimpsed the entirety of my memory...", []],
            [0, "MoveEvent", "", [2, 8, 0, 0, 0, 0, 1, 1]],
            [0, "Wait", "", [20]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "You're lucky, Talan - if the Pathway", []],
            [0, "ShowMessage_2", "had remained open for any longer, your", []],
            [0, "ShowMessage_2", "body might not have recovered as quickly.", []],
            [0, "Wait", "", [20]],
            [0, "ShowMessage", "TALAN", []],
            [0, "ShowMessage_2", "It was... overwhelming - so many voices!", []],
            [0, "ShowMessage_2", "Each one had its story to tell, and each", []],
            [0, "ShowMessage_2", "story was one of despair... it was horrible.", []],
            [0, "ShowMessage", "TALAN", []],
            [0, "ShowMessage_2", "I can't remember any specifics, though.", []],
            [0, "ShowMessage_2", "Just terrible, terrible pain and anger.", []],
            [0, "ShowMessage", "TALAN", []],
            [0, "ShowMessage_2", "I don't know how you can live with it.", []],
            [0, "MoveEvent", "", [2, 8, 0, 0, 12]],
            [0, "Wait", "", [10]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "Oh, I think you do, dearie. We all have", []],
            [0, "ShowMessage_2", "our own ways of dealing with our dark", []],
            [0, "ShowMessage_2", "little secrets.", []],
            [0, "Wait", "", [5]],
            [0, "MoveEvent", "", [10001, 8, 0, 0, 13]],
            [0, "Wait", "", [10]],
            [0, "ShowMessage", "TALAN", []],
            [0, "ShowMessage_2", "... ... ...", []],
            [0, "Wait", "", [15]],
            [0, "MoveEvent", "", [3, 8, 0, 0, 12]],
            [0, "Wait", "", [10]],
            [0, "ShowMessage", "EMILY", []],
            [0, "ShowMessage_2", "But what do we do now?", []],
            [0, "ShowMessage_2", "Where should we go?", []],
            [0, "MoveEvent", "", [2, 8, 0, 0, 13]],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "I know where you should not go:", []],
            [0, "ShowMessage_2", "the ruins of Surl are not for the", []],
            [0, "ShowMessage_2", "faint-hearted.", []],
            [0, "MoveEvent", "", [3, 8, 0, 0, 15]],
            [0, "ShowMessage", "EMILY", []],
            [0, "ShowMessage_2", "We can't just go back north! The Agency", []],
            [0, "ShowMessage_2", "is probably still at... well, still on our trail...", []],
            [0, "MoveEvent", "", [10001, 8, 0, 0, 15]],
            [0, "Wait", "", [10]],
            [0, "ShowMessage", "TALAN", []],
            [0, "ShowMessage_2", "I think we should go west. The Agency", []],
            [0, "ShowMessage_2", "probably expects us to try and escape", []],
            [0, "ShowMessage_2", "through Surl to the south, and if we", []],
            [0, "ShowMessage", "TALAN", []],
            [0, "ShowMessage_2", "go east, we're heading straight for", []],
            [0, "ShowMessage_2", "Prima City and the heart of the", []],
            [0, "ShowMessage_2", "Agency's power structure.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "There is a set of tunnels nearby that", []],
            [0, "ShowMessage_2", "may get you beyond the western", []],
            [0, "ShowMessage_2", "mountains.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "I'll show you the way first thing in", []],
            [0, "ShowMessage_2", "the morning. And Talan... I'm sorry", []],
            [0, "ShowMessage_2", "for intruding on your own memories.", []],
            [0, "ShowMessage", "MEMNOSYNE", []],
            [0, "ShowMessage_2", "It was good to share my story with", []],
            [0, "ShowMessage_2", "you all, though. I'm glad you came.", []],
            [0, "TintScreen", "", [0, 0, 0, 100, 10, 1]],
            [0, "Wait", "", [10]],
            [0, "ConditionalBranch", "", [0, 385, 0, 0, 0, 1]],
            [1, "MessageOptions", "", [0, 2, 0, 0]],
            [1, "ShowMessage", "SERN", []],
