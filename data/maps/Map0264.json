            {"code": "Wait", "parameters": [8]},
            {"code": "ShowMessage", "string": "KERSH"},
            {"code": "ShowMessage_2", "string": "I know... but these... are different."},
            {"code": "ShowMessage", "string": "KERSH"},
            {"code": "ShowMessage_2", "string": "Sometimes... I see things that..."},
            {"code": "ShowMessage_2", "string": "aren't from... the Surl people."},
            {"code": "Wait", "parameters": [10]},
