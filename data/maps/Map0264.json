            {"code": "ShowMessage_2", "string": "and angry."},
            {"code": "MoveEvent", "parameters": [8, 8, 0, 0, 13]},
            {"code": "ProceedWithMovement"},
            {"code": "Wait", "parameters": [8]},
            {"code": "ShowMessage", "string": "KERSH"},
            {"code": "ShowMessage_2", "string": "And whenever my eyes... are closed..."},
            {"code": "ShowMessage_2", "string": "I see myself... doing things. Things that..."},
            {"code": "ShowMessage_2", "string": "horrible things..."},
            {"code": "MoveEvent", "parameters": [8, 8, 0, 0, 14, 23, 24, 25]},
            {"code": "ProceedWithMovement"},
            {"code": "ShowMessage", "string": "KERSH"},
            {"code": "ShowMessage_2", "string": "Death! Everywhere! And... I see..."},
            {"code": "MoveEvent", "parameters": [9, 8, 0, 0, 24, 25]},
            {"code": "ProceedWithMovement"},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "Kersh, it's OK... everything's all right..."},
