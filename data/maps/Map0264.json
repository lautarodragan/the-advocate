            {"code": "ShowMessage_2", "string": "Terrible... things..."},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "You're getting better at speaking"},
            {"code": "ShowMessage_2", "string": "already, Kersh. I bet it'll be just like"},
            {"code": "ShowMessage_2", "string": "that with the bad dreams."},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "Before too long, you won't even notice the"},
            {"code": "ShowMessage_2", "string": "bad dreams, wherever it is they come from."},
            {"code": "MoveEvent", "parameters": [8, 8, 0, 0, 15]},
            {"code": "ProceedWithMovement"},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "KERSH"},
            {"code": "ShowMessage_2", "string": "Can you... can you keep a... secret?"},
            {"code": "MoveEvent", "parameters": [9, 8, 0, 0, 23, 23, 15, 23, 23, 23, 13]},
            {"code": "ProceedWithMovement"},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "What's wrong?"},
            {"code": "MoveEvent", "parameters": [8, 8, 0, 0, 14]},
