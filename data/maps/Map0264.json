            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "Why would... why do you say that?"},
            {"code": "Wait", "parameters": [10]},
            {"code": "ShowMessage", "string": "KERSH"},
            {"code": "ShowMessage_2", "string": "Whenever my eyes... are open... I see"},
