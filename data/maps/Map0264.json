            {"code": "PlayBGM", "parameters": [0, 100, 100, 50], "string": "Winter_8_CA"},
            {"code": "ShowMessage", "string": "KERSH"},
            {"code": "ShowMessage_2", "string": "Those... things I see when I sleep..."},
            {"code": "Wait", "parameters": [6]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "We talked about those, remember?"},
            {"code": "ShowMessage_2", "string": "Those are dreams. You're probably"},
            {"code": "ShowMessage_2", "string": "dreaming about Surl as it used to be."},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "Memnosyne said she got used to having"},
