            {"code": "ProceedWithMovement"},
            {"code": "Wait", "parameters": [12]},
            {"code": "MoveEvent", "parameters": [9, 8, 0, 0, 13]},
            {"code": "ProceedWithMovement"},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "We all lived at a place called Paradise."},
            {"code": "ShowMessage_2", "string": "It was small, but... it was beautiful. We"},
            {"code": "ShowMessage_2", "string": "were all so happy."},
            {"code": "ShowMessage", "string": "EMILY"},
            {"code": "ShowMessage_2", "string": "All our friends were right there - you"},
            {"code": "ShowMessage_2", "string": "never needed to worry about being"},
            {"code": "ShowMessage_2", "string": "lonely, or afraid."},
            {"code": "Wait", "parameters": [5]},
            {"code": "ShowMessage", "string": "KERSH"},
            {"code": "ShowMessage_2", "string": "I want to... dream about Paradise... instead"},
            {"code": "ShowMessage_2", "string": "of Surl. I hate Surl! Tell me more... about"},
            {"code": "ShowMessage_2", "string": "Paradise... please."},
            {"code": "Wait", "parameters": [8]},
            {"code": "ConditionalBranch", "parameters": [0, 388, 0, 0, 0, 1]},
