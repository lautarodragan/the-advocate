# The test game's recipes: making the game out of its text, building its
# cartridge and running its tests. The tools come from the PATH, as for any
# game: `just install` at the root installs them.
#
# It runs standing in `test-game/`, wherever it is called from; the root's
# `just test-game` calls `test` here.

# A worktree's tools first, like the root's `justfile` does: the
# `.local-tools/` that `just install-local .local-tools <projects>` builds at
# the repository's root.
local_tools := justfile_directory() / ".." / ".local-tools"
export PATH := if path_exists(local_tools / "bin") == "true" { local_tools / "bin" + ":" + env_var("PATH") } else { env_var("PATH") }

# The SoundFont the converter makes the music with. It belongs to the
# machine, so it comes in a variable, like `SOUNDFONT` for the audio tests,
# and there is no default. The game has no music yet, but the converter asks
# for one all the same; and once it has, the samples end up in the
# cartridge, so for the cartridge to be distributable the SoundFont has to be
# a free one.
export SOUNDFONT := env_var_or_default("SOUNDFONT", "")

# The game out of `src/`, into `build/game/` —the RM2k files, with the
# assets beside them, which is what RPG Maker or EasyRPG open— and imported
# back into `build/data/`, the dump the converter reads, as a port's `just
# dump` imports its game.
#
# `src/` is a Ditto exact dump written by hand, the maps' tile layers too,
# in their `.tiles`, and `advocate export` writes it as RPG Maker's files.
# Importing back what was just exported instead of handing the converter
# `src/` is on purpose: the converter reads what the RM2k files say, as it
# does for a port, and a field the export drops is seen.
#
# **And `advocate import` checks its own round trip**: the exact dump it
# leaves in `build/exact/`, exported again, has to give back every `.lmu`,
# `.ldb` and `.lmt` byte for byte, or it fails. Here it proves Ditto reads
# what Ditto writes, in CI, where no game of anyone else's can go; that it
# reads what RPG Maker wrote, each port's `just dump` checks. Until
# 2026-11-25 it was `tests/test_round_trip.py` —taro's, that day: no test
# runs a binary of ours—, and until 2026-11-27 this recipe ran `ditto pack`
# and `ditto unpack` and compared the files itself.
#
# Makes the RM2k game out of src/ and imports it to build/data/.
game:
  #!/usr/bin/env sh
  set -eu
  rm -rf build/game build/exact build/data
  mkdir -p build
  advocate export src build/game
  cp src/RPG_RT.ini build/game/
  cp -r ChipSet CharSet FaceSet Monster Panorama Picture System Title build/game/
  advocate import --game-dir build/game

# `--rtp-dir` an empty directory: the game uses nothing from any RTP, and
# what it uses is in this folder. A picture missing here is an error, and not
# one found in the machine's RTP.
#
# Makes the game and builds its cartridges, without MSU-1 tracks.
cartridges *args: game
  #!/usr/bin/env sh
  set -eu
  if [ -z "$SOUNDFONT" ]; then
    echo "The test game needs SOUNDFONT=<a .sf2>: a free one, since its samples end up in the cartridge." >&2
    exit 1
  fi
  mkdir -p build/no-rtp
  advocate build --game-dir build/game --rtp-dir build/no-rtp --soundfont "$SOUNDFONT" --without-tracks {{args}}

# The tests run the cartridge in an emulator —a libretro core, see
# `rm2k-snes/harness/` at the root—, and build nothing: this recipe builds
# first.
#
# Builds the cartridges and runs the game's tests.
test *args: cartridges
  pytest tests {{args}}

# **Goombario over every cartridge**, for the root's `just lint`: the traps
# that assemble fine and are wrong —a conditional branch on a flag a `pl*`
# left, a routine entered with `jsl` that returns with `rts`, a path that
# leaves bytes on the stack, a width that is not the one the source
# declares—. What is fine and flagged anyway says so on its own line of the
# runtime, `; goombario: <check>: <why>`; one that allows nothing any more
# is red too. Only the runtime is looked at: what the converter generates
# is data. Its README, in `snes/goombario/`, says what it does not see.
#
# Every cartridge, because Goombario sees only what was assembled: `lint`
# carries every flag the runtime assembles code on, and the others what
# those flags leave out —see `advocate.toml`—. It is a lint and not a test:
# until 2026-11-25 it was `tests/test_linter.py` here, and A Blurred Line's
# over its own cartridges.
#
# **The runtime it lints is the one the tools were installed from**, which
# is the one the build assembles, so it refuses when that is not this
# checkout's: in a worktree, `just install-local .local-tools advocate`
# first.
#
# Builds the cartridges and runs Goombario over each.
lint: cartridges
  #!/usr/bin/env python3
  import json, os, re, subprocess, sys
  listing = json.load(open("build/advocate.json"))["listing"]
  here = os.path.realpath("..")
  if os.path.realpath(listing["root"]) != here:
      sys.exit(f"lint: the tools assemble the runtime of {listing['root']}, not this "
               f"checkout's ({here}): `just install-local .local-tools advocate` here")
  # Where `ca65` ran: the source paths in the `.dbg` are relative to it.
  runtime = os.path.relpath(listing["runtime"], listing["root"]) + "/"
  failed = []
  for c in listing["cartridges"]:
      done = subprocess.run(
          ["goombario", c["rom"], "--root", listing["root"], "--only", runtime, "--stats"],
          capture_output=True, text=True)
      # And that it looked at something: a badly read `.dbg` gives zero
      # without checking anything, which is what happened to the first
      # version of the banks' guard, in A Blurred Line.
      seen = {k: int(v) for k, v in re.findall(
          r"(instructions|pulls|entries|returns reached) (\d+)", done.stderr)}
      blind = [k for k in ("instructions", "pulls", "entries", "returns reached")
               if seen.get(k, 0) <= 100]
      if done.returncode != 0 or blind:
          failed.append(c["name"])
          print(f"{c['name']}: goombario exited {done.returncode}"
                + (f", and looked at too little: {', '.join(blind)}" if blind else ""))
          sys.stdout.write(done.stdout + done.stderr)
      else:
          print(f"{c['name']}: {done.stderr.splitlines()[0]}")
  if failed:
      sys.exit(f"lint: goombario is red on {', '.join(failed)}")

# **Leaves `release` for taro in `$SHARED/builds/test-game/`**, the shape of
# the ports' `just deliver`: `test-game.sfc`, its `.sfc.dbg` for Mesen2's
# debugger, the `runtime/` it was assembled from —Mesen2 finds the source
# going up folders from the `.dbg`— and a `README.txt` with the commits and
# what is passed as what to look at. No `.msu` and no tracks: the game has
# no music nor battles yet, and its cartridges build without tracks. The
# previous build's files are overwritten, and whatever else is there stays.
#
# `SHARED` belongs to the machine, like `SOUNDFONT`: the ports' is in their
# `machine.just`, and this has no default. It refuses with uncommitted
# changes in the game or in the runtime it is built with, since the README
# names their commits: the game's, this checkout's; the runtime's, that of
# the checkout the tools were installed from, which the build leaves in
# `build/advocate.json`.
#
#     SHARED=<where taro looks> SOUNDFONT=<a .sf2> just deliver "What changed and what to look at."
#
# Builds release and delivers it to $SHARED/builds/test-game/.
deliver what_to_look_at: (cartridges "release")
  #!/usr/bin/env bash
  set -euo pipefail
  shared="${SHARED:-}"
  [ -n "$shared" ] || { echo "deliver: SHARED=<the folder taro sees> is not set" >&2; exit 1; }
  [ -d "$shared" ] || { echo "deliver: $shared does not exist" >&2; exit 1; }
  project=$(cat build/advocate.json)
  tools=$(echo "$project" | python3 -c 'import json, sys; print(json.load(sys.stdin)["suite"]["root"])')
  name=$(echo "$project" | python3 -c 'import json, sys; print(json.load(sys.stdin)["settings"]["rom"]["name"])')
  dirty=$(git status --porcelain -- . ; git -C "$tools" status --porcelain -- runtime)
  if [ -n "$dirty" ]; then
    echo "deliver: there are uncommitted changes, and the README names the commits:" >&2
    echo "$dirty" >&2
    exit 1
  fi
  dest="$shared/builds/test-game"
  mkdir -p "$dest"
  cp "build/release/$name.sfc" "build/release/$name.sfc.dbg" "$dest/"
  rm -rf "$dest/runtime"
  git -C "$tools" archive HEAD runtime | tar -x -C "$dest"
  {
    echo "$name.sfc of commit $(git rev-parse --short HEAD) ($(date +%F)): $(git log -1 --format=%s)"
    echo "Built with the runtime of commit $(git -C "$tools" rev-parse --short HEAD): $(git -C "$tools" log -1 --format=%s)"
    echo
    printf '%s\n' {{quote(what_to_look_at)}} | fold -s -w 76
    echo
    echo "How to play it: the game starts on the meadow. The signpost on the"
    echo "left is the guide, who teleports to every map; the board right below"
    echo "the hero is the tester, who runs every case of the tests from its"
    echo "menus. Both hand out the Way Home, an item that brings the hero back"
    echo "to the meadow from anywhere: the pause menu, then the items. See"
    echo "test-game/README.md."
    echo
    echo "$name.sfc.dbg: the routines' names for Mesen2's debugger, which loads"
    echo "it on its own next to the ROM; runtime/ is the source it shows (Ctrl+Q)."
  } > "$dest/README.txt"
  echo "deliver: $dest"
