__pycache__/

wt/
rom/build/
# Lo que escriben las pruebas mientras corren —las fotos del recorrido y las
# capturas que difieren de su golden—, al lado de `pruebas/golden/`, que es
# contra lo que se comparan. Es salida de las pruebas y no del build, por eso
# no va en `rom/build/`.
pruebas/snapshots/
# Las ROMs para probar a mano, con sus pistas de MSU-1. Viven acá y no en
# `rom/build/` porque eso lo pisan las pruebas y el `snes-demos` siguiente; y
# adentro del repo y no en `/extras` porque taro las saca desde el host y desde
# ahí había que copiarlas con `podman cp` cada vez. Pesan: un build con las ocho
# pistas son 383 MB.
pruebas-manuales/
# Los worktrees de los sub-agentes. Son repositorios de git adentro del repo, y
# un `git add -A` los mete al índice como submódulos rotos: pasó el 2026-09-13.
.claude/worktrees/
rom/shots/

# El sandbox de Claude Code tapa los archivos de configuración que podrían
# ejecutar algo, montándoles /dev/null encima. Como acá no existían, quedan como
# nodos de dispositivo en la raíz del repo y `git add -A` se corta con
# "can only add regular files, symbolic links or git-directories".
#
# Están montados mientras dure la sesión: no se borran, se ignoran.
# Cuidado si algún día el repo usa submódulos: .gitmodules es de git, no basura.
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.mcp.json
.ripgreprc
.vscode

# El target de Ditto: binarios y dependencias compiladas.
tools/ditto/target/
tools/ditto/.idea/
