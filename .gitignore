__pycache__/

wt/
# The sub-agents' worktrees. They are git repositories inside the repo, and
# a `git add -A` puts them in the index as broken submodules: it happened on
# 2026-09-13.
.claude/worktrees/

# Claude Code's sandbox covers the configuration files that could run
# something by mounting /dev/null over them. Since they did not exist here,
# they are left as device nodes at the root of the repo and `git add -A` stops
# with "can only add regular files, symbolic links or git-directories".
#
# They stay mounted for as long as the session lasts: they are not deleted,
# they are ignored. Careful if the repo ever uses submodules: .gitmodules
# belongs to git, it is not garbage.
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.mcp.json
.ripgreprc
.vscode

# The Rust workspace's target: the binaries and the compiled dependencies of
# every crate, which share a single one.
target/
rm2k/ditto/.idea/
# A worktree's tools: `install-local`, see `justfile`. The destination is
# chosen by whoever uses them; the recipes of `justfile` look for theirs in
# `.local-tools/`.
.local-tools/
